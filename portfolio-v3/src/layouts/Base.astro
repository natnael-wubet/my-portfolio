---
import "../styles/global.css";
import { locales, makeT, type Lang } from "../i18n";
import { structuredData } from "../lib/structured-data";

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
}
const { lang = "en", title, description } = Astro.props;

const t = makeT(lang);
const loc = locales[lang];
const pageTitle = title ?? t("meta.title");
const pageDescription = description ?? t("meta.description");

// Machine-readable siblings: the profile, the LLM index and the Markdown CV.
// JSON-LD is generated from the same profile, so it cannot drift from the page.
const ld = JSON.stringify(structuredData()).replace(/</g, "\\u003c");

// Ethiopic has no Latin glyphs — only the Amharic page pays for the font.
const fontHref =
  "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&family=Space+Grotesk:wght@500;600;700&display=swap";
const fontHrefAm =
  "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&family=Space+Grotesk:wght@500;600;700&family=Noto+Sans+Ethiopic:wght@400;500;600;700&display=swap";
---
<!doctype html>
<html lang={loc.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#08090a" id="theme-color-meta" />
    <meta name="author" content="Natnael Wubet" />
    <!-- Both locales are static; tell crawlers they exist as siblings. -->
    <link rel="alternate" hreflang="en" href="/" />
    <link rel="alternate" hreflang="am" href="/am/" />
    <link rel="alternate" hreflang="x-default" href="/" />
    <!-- The same person, in formats a tool can consume. -->
    <link rel="alternate" type="application/json" href="/profile.json" title="Machine-readable profile" />
    <link rel="alternate" type="application/schema+json" href="/profile.schema.json" title="Profile schema" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Index for LLM crawlers" />
    <link rel="alternate" type="text/markdown" href="/resume.md" title="Markdown CV" />
    <link rel="author" href="/profile.json" />
    <script type="application/ld+json" set:html={ld} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={loc.ogLocale} />
    <meta property="og:locale:alternate" content={lang === "en" ? "am_ET" : "en_US"} />
    <meta property="og:image" content="/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Natnael Wubet — Software Engineer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content="/og.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={lang === "am" ? fontHrefAm : fontHref} rel="stylesheet" />
    <!--
      Opt-in reveal: only mark the document as scriptable once JS is confirmed
      running, so a failed script leaves every [data-reveal] block visible
      instead of stranded at opacity 0.
    -->
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <!--
      Theme + accent are applied before first paint so switching never flashes
      the wrong colour scheme. Mirrors src/scripts/options.ts — keep in sync.
    -->
    <script is:inline>
      (() => {
        try {
          const root = document.documentElement;
          const mq = window.matchMedia("(prefers-color-scheme: light)");
          const pref = (k, d) => localStorage.getItem(k) || d;
          // Shareable links carry ?theme=&accent=; honour them before paint.
          const params = new URLSearchParams(location.search);
          const urlTheme = params.get("theme");
          const urlAccent = params.get("accent");
          const themePref = ["dark", "light", "system"].includes(urlTheme) ? urlTheme : pref("cv:theme", "system");
          const theme = themePref === "system" ? (mq.matches ? "light" : "dark") : themePref;
          root.dataset.theme = theme;
          root.dataset.accent = ["lime", "cyan", "amber", "rose", "violet"].includes(urlAccent)
            ? urlAccent
            : pref("cv:accent", "lime");
          root.style.colorScheme = theme;
          const meta = document.getElementById("theme-color-meta");
          if (meta) meta.setAttribute("content", theme === "light" ? "#f7f8f6" : "#08090a");
        } catch {
          /* private mode / blocked storage — the dark default stands */
        }
      })();
    </script>
    <style is:global>
      .js [data-reveal] {
        opacity: 0;
        transform: translateY(22px);
        transition:
          opacity 0.85s cubic-bezier(0.16, 1, 0.3, 1) var(--d, 0ms),
          transform 0.85s cubic-bezier(0.16, 1, 0.3, 1) var(--d, 0ms);
        will-change: opacity, transform;
      }

      .js [data-reveal].is-in {
        opacity: 1;
        transform: none;
      }

      /* Safety net: if the observer never runs, force everything visible. */
      .js.reveal-timeout [data-reveal] {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }

      /* ── Scroll progress hairline ─────────────────────────────── */
      .scroll-progress {
        position: fixed;
        inset: 0 0 auto 0;
        height: 2px;
        z-index: 90;
        pointer-events: none;
      }

      .scroll-progress span {
        display: block;
        height: 100%;
        background: linear-gradient(90deg, var(--color-signal), var(--color-cyan));
        transform: scaleX(0);
        transform-origin: 0 50%;
        will-change: transform;
      }

      /* ── Keyboard focus ───────────────────────────────────────── */
      :focus-visible {
        outline: 2px solid var(--color-signal);
        outline-offset: 3px;
        border-radius: 1px;
      }

      .skip-link {
        position: fixed;
        top: -100px;
        left: 1rem;
        z-index: 100;
        padding: 0.7rem 1rem;
        background: var(--color-signal);
        color: var(--color-on-signal);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        text-decoration: none;
        transition: top 0.2s ease;
      }

      .skip-link:focus-visible {
        top: 1rem;
      }

      /* ── Reduced motion ───────────────────────────────────────── */
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }

        .js [data-reveal] {
          opacity: 1 !important;
          transform: none !important;
        }
      }

      /* ── Amharic typography ─────────────────────────────────────
         Ethiopic syllabaries carry their own rhythm: no case, wider
         default spacing, taller ascenders. The Latin-first display
         stack would also leave every heading in a fallback face, so
         the families are re-ordered for [lang="am"] and the tiny
         tracked labels get bumped to a readable size. */
      html[lang="am"] {
        --font-sans: "Inter", "Noto Sans Ethiopic", ui-sans-serif, system-ui, sans-serif;
        --font-mono: "IBM Plex Mono", "Noto Sans Ethiopic", ui-monospace, monospace;
        --font-display: "Noto Sans Ethiopic", "Space Grotesk", "Inter", sans-serif;
      }

      html[lang="am"] [class*="tracking-"] {
        letter-spacing: 0.02em !important;
      }

      html[lang="am"] .display {
        letter-spacing: 0;
        line-height: 1.1;
      }

      /* 9–11px labels are unreadable in Ethiopic — floor them at 11–12px. */
      html[lang="am"] [class*="text-[0.5"] {
        font-size: 0.7rem !important;
      }

      html[lang="am"] [class*="text-[0.6"] {
        font-size: 0.75rem !important;
      }
    </style>
  </head>
  <body>
    <div class="rule-grid" aria-hidden="true"></div>
    <!-- Scroll progress: one hairline of signal, top of viewport -->
    <div class="scroll-progress" aria-hidden="true"><span id="scroll-progress-bar"></span></div>
    <a class="skip-link" href="#top">{t("nav.skip")}</a>
    <slot />
    <script>
      import Lenis from "lenis";
      const lenis = new Lenis({ lerp: 0.075, smoothWheel: true });
      function raf(time: number) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }
      requestAnimationFrame(raf);
      (window as unknown as { lenis: Lenis }).lenis = lenis;

      // ── Scroll progress ────────────────────────────────────────
      const bar = document.getElementById("scroll-progress-bar");
      const paintProgress = () => {
        if (!bar) return;
        const max = document.documentElement.scrollHeight - window.innerHeight;
        bar.style.transform = `scaleX(${max > 0 ? Math.min(window.scrollY / max, 1) : 0})`;
      };
      paintProgress();
      window.addEventListener("scroll", paintProgress, { passive: true });
      window.addEventListener("resize", paintProgress);

      // ── Reduced motion: stop the smooth scroll, reveal everything ─
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reduced) {
        lenis.destroy();
        (window as unknown as { lenis?: Lenis }).lenis = undefined;
      }

      // ── Anchors: account for the fixed header ───────────────────
      document.addEventListener("click", (e) => {
        const link = (e.target as HTMLElement | null)?.closest?.('a[href^="#"]');
        if (!link) return;
        const id = link.getAttribute("href");
        if (!id || id === "#") return;
        const target = document.querySelector(id);
        if (!target) return;
        e.preventDefault();
        const top = target.getBoundingClientRect().top + window.scrollY - 64;
        if (reduced || !window.lenis) {
          window.scrollTo({ top: Math.max(top, 0), behavior: reduced ? "auto" : "smooth" });
        } else {
          window.lenis.scrollTo(Math.max(top, 0), { duration: 1.1 });
        }
        history.replaceState(null, "", id);
      });

      // ── Scroll reveals ────────────────────────────────────────
      const start = () => {
        const nodes = Array.from(document.querySelectorAll<HTMLElement>("[data-reveal]"));
        if (!nodes.length) return;

        if (!("IntersectionObserver" in window)) {
          nodes.forEach((n) => n.classList.add("is-in"));
          return;
        }

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (!e.isIntersecting) return;
              e.target.classList.add("is-in");
              io.unobserve(e.target);
            });
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.05 }
        );

        nodes.forEach((n) => io.observe(n));

        // Anything already on screen reveals immediately; anything the
        // observer somehow misses gets released by the CSS timeout guard.
        requestAnimationFrame(() => {
          nodes.forEach((n) => {
            const r = n.getBoundingClientRect();
            if (r.top < window.innerHeight && r.bottom > 0) n.classList.add("is-in");
          });
        });

        window.setTimeout(() => document.documentElement.classList.add("reveal-timeout"), 6000);
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", start, { once: true });
      } else {
        start();
      }
    </script>
  </body>
</html>
