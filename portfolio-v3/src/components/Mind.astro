---
import { disciplines, youtube } from "../data/content";
import { rich, td, type T } from "../i18n";

interface Props {
  t: T;
}
const { t } = Astro.props;
---

<section id="mind" class="relative border-t border-[var(--color-line)] overflow-hidden">
  <!-- faint field so the section reads differently from the rest -->
  <div class="pointer-events-none absolute inset-0 -z-10 opacity-[0.35]" aria-hidden="true"
    style="background-image: radial-gradient(circle at 1px 1px, var(--color-line-2) 1px, transparent 0); background-size: 28px 28px; mask-image: radial-gradient(ellipse 90% 70% at 50% 40%, #000 10%, transparent 75%);"></div>

  <div class="shell py-24 lg:py-32">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div class="flex flex-col gap-5">
        <span class="eyebrow">{t("sec.mind.eyebrow")}</span>
        <h2 class="display display-lg" set:html={rich(t("sec.mind.title"))} />
      </div>
      <p class="max-w-md text-[var(--color-fog-2)]">
        {t("sec.mind.lead")}
      </p>
    </div>

    <!-- Disciplines.
         Five cards, the last one spanning two columns: 6 cells, which divides
         evenly by both 2 (md) and 3 (xl) so no cell is ever stranded. -->
    <div class="mt-14 grid gap-px bg-[var(--color-line)] md:grid-cols-2 xl:grid-cols-3">
      {
        disciplines.map((d, i) => (
          <article
            class={`group relative flex flex-col gap-4 bg-[var(--color-ink)] p-7 transition-colors duration-300 hover:bg-[var(--color-ink-2)] lg:p-8 ${
              i === disciplines.length - 1 ? "md:col-span-2" : ""
            }`}
            data-reveal
            style={`--d:${i * 70}ms`}
          >
            <div class="flex items-start justify-between gap-4">
              <span class="font-mono text-[0.625rem] tracking-[0.2em] text-[var(--color-line-2)] uppercase">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span
                class="h-px w-10 bg-[var(--color-line-2)] transition-all duration-500 group-hover:w-16 group-hover:bg-[var(--color-signal)]"
                aria-hidden="true"
              />
            </div>

            <h3 class="font-display text-2xl font-semibold tracking-tight text-[var(--color-chalk)] transition-colors duration-300 group-hover:text-[var(--color-signal)]">
              {td(t, d.name)}
            </h3>

            <p class="max-w-2xl text-sm leading-relaxed text-[var(--color-fog-2)]">{td(t, d.blurb)}</p>

            <div class="mt-auto flex flex-wrap gap-1.5 pt-3">
              {d.tags.map((tag) => (
                <span class="border border-[var(--color-line)] px-2 py-1 font-mono text-[0.5625rem] tracking-[0.1em] text-[var(--color-fog)] uppercase">
                  {td(t, tag)}
                </span>
              ))}
            </div>
          </article>
        ))
      }
    </div>

    <!-- YouTube channel gets its own full-width band -->
    <a
      href={youtube.url}
      target="_blank"
      rel="noopener"
      class="group relative mt-px flex flex-col gap-5 overflow-hidden border border-[var(--color-line)] bg-[var(--color-ink-2)] p-7 no-underline transition-colors duration-300 hover:border-[var(--color-line-2)] lg:flex-row lg:items-center lg:gap-8 lg:p-9"
      data-reveal
      style="--d:120ms"
    >
      <div
        class="pointer-events-none absolute -right-20 top-1/2 h-72 w-72 -translate-y-1/2 rounded-full opacity-30 blur-3xl transition-opacity duration-500 group-hover:opacity-60"
        style="background: radial-gradient(circle, #ff5470 0%, transparent 70%);"
        aria-hidden="true"
      />

      <div class="relative flex flex-none items-center gap-4">
        <span class="grid h-14 w-14 place-items-center overflow-hidden rounded-full border border-[var(--color-line-2)] bg-[var(--color-ink-3)]">
          <img
            src="/img/youtube-avatar.jpg"
            alt="Abyss Science"
            width="900"
            height="900"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover"
          />
        </span>
        <span class="flex flex-col">
          <span class="font-mono text-[0.625rem] tracking-[0.2em] text-[var(--color-fog)] uppercase">{t("sec.mind.youtube", { handle: youtube.handle })}</span>
          <span class="font-display text-xl font-semibold tracking-tight text-[var(--color-chalk)] transition-colors group-hover:text-[var(--color-signal)]">
            {youtube.title}
          </span>
        </span>
      </div>

      <p class="relative max-w-2xl flex-1 text-sm leading-relaxed text-[var(--color-fog-2)]">{td(t, youtube.blurb)}</p>

      <span class="relative flex flex-none items-center gap-2 self-start border border-[var(--color-line-2)] px-5 py-2.5 font-mono text-[0.6875rem] tracking-[0.16em] text-[var(--color-chalk)] uppercase transition-colors group-hover:border-[var(--color-signal)] group-hover:text-[var(--color-signal)] lg:self-auto">
        {t("sec.mind.watch")} <span class="transition-transform duration-300 group-hover:translate-x-1">↗</span>
      </span>
    </a>
  </div>
</section>
