---
import { originIntro, originBody, heritage, timeline } from "../data/content";
import { td, type T } from "../i18n";

interface Props {
  t: T;
}
const { t } = Astro.props;

const chips = t("sec.origin.chips").split("|");
---

<section id="origin" class="relative border-t border-[var(--color-line)]">
  <div class="shell py-24 lg:py-32">
    <div class="flex flex-col gap-5">
      <span class="eyebrow">{t("sec.origin.eyebrow")}</span>
      <h2 class="display display-lg max-w-4xl">{td(t, originIntro)}</h2>
    </div>

    <div class="mt-14 grid gap-12 lg:grid-cols-[1.15fr_1fr] lg:gap-20">
      <!-- Narrative -->
      <div class="flex flex-col gap-7">
        {
          originBody.map((p, i) => (
            <p class="text-base leading-relaxed text-[var(--color-fog-2)] lg:text-lg" data-reveal style={`--d:${i * 60}ms`}>
              {p.lead && (
                <span class="mr-3 inline-block border border-[var(--color-line-2)] px-2 py-0.5 align-middle font-mono text-[0.5625rem] tracking-[0.18em] text-[var(--color-signal)] uppercase">
                  {td(t, p.lead)}
                </span>
              )}
              <span class="text-[var(--color-chalk)]">{td(t, p.text)}</span>
            </p>
          ))
        }
      </div>

      <!-- Heritage card -->
      <aside class="panel flex h-fit flex-col gap-4 p-7 lg:sticky lg:top-24" data-reveal>
        <div class="flex items-center gap-3">
          <span class="grid h-9 w-9 place-items-center border border-[var(--color-line-2)] font-mono text-[0.625rem] text-[var(--color-signal)]">BD</span>
          <span class="font-mono text-[0.625rem] tracking-[0.2em] text-[var(--color-fog)] uppercase">{t("sec.origin.heritageTitle")}</span>
        </div>
        <p class="text-sm leading-relaxed text-[var(--color-fog-2)]">{td(t, heritage.text)}</p>
        <div class="mt-2 flex flex-wrap gap-2 border-t border-[var(--color-line)] pt-4">
          {
            chips.map((c) => (
              <span class="border border-[var(--color-line)] px-2.5 py-1 font-mono text-[0.5625rem] tracking-[0.14em] text-[var(--color-fog)] uppercase">
                {c}
              </span>
            ))
          }
        </div>
      </aside>
    </div>

    <!-- Timeline -->
    <div class="mt-20 border-t border-[var(--color-line)] pt-10">
      <div class="mb-8 flex items-center justify-between">
        <span class="section-label">{t("sec.origin.milestones")}</span>
        <span class="section-index">{t("sec.origin.entries", { n: timeline.length })}</span>
      </div>

      <ol class="relative m-0 list-none p-0">
        <span class="absolute top-2 bottom-2 left-[0.4rem] w-px bg-[var(--color-line)] lg:left-[0.55rem]" aria-hidden="true"></span>
        {
          timeline.map((m, i) => (
            <li class="group relative grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 py-6 pl-0 lg:grid-cols-[9rem_auto_1fr] lg:gap-x-8" data-reveal style={`--d:${i * 70}ms`}>
              <span class="font-mono text-sm tracking-[0.14em] text-[var(--color-fog)] tabular-nums lg:text-base">{m.year}</span>

              <span
                class="relative z-10 mt-1.5 h-2 w-2 flex-none rounded-full bg-[var(--color-line-2)] ring-4 ring-[var(--color-ink)] transition-colors duration-300 group-hover:bg-[var(--color-signal)] lg:mt-2"
                aria-hidden="true"
              />

              <div class="col-start-2 flex flex-col gap-1.5 lg:col-start-3">
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <h3 class="font-display text-lg font-semibold tracking-tight text-[var(--color-chalk)] transition-colors duration-300 group-hover:text-[var(--color-signal)]">
                    {td(t, m.title)}
                  </h3>
                  <span class="border border-[var(--color-line)] px-2 py-0.5 font-mono text-[0.5625rem] tracking-[0.14em] text-[var(--color-fog)] uppercase transition-colors duration-300 group-hover:border-[var(--color-line-2)]">
                    {td(t, m.tag)}
                  </span>
                </div>
                <p class="max-w-2xl text-sm leading-relaxed text-[var(--color-fog-2)]">{td(t, m.detail)}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
