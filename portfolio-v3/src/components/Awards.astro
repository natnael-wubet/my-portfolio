---
import { awards, certifications, communities } from "../data/content";
import { rich, type T } from "../i18n";

interface Props {
  t: T;
}
const { t } = Astro.props;
---

<section id="awards" class="relative border-t border-[var(--color-line)]">
  <div class="shell py-24 lg:py-32">
    <div class="flex flex-col gap-5">
      <span class="eyebrow">{t("sec.awards.eyebrow")}</span>
      <h2 class="display display-lg" set:html={rich(t("sec.awards.title"))} />
    </div>

    <div class="mt-14 grid gap-12 lg:grid-cols-[1.35fr_1fr] lg:gap-16">
      <!-- Awards -->
      <div class="flex flex-col">
        <div class="mb-4 flex items-center justify-between border-b border-[var(--color-line)] pb-3">
          <span class="section-label">{t("sec.awards.competitions")}</span>
          <span class="section-index">{t("sec.awards.entries", { n: awards.length })}</span>
        </div>

        <div class="flex flex-col">
          {
            awards.map((a, i) => (
              <article class="group grid grid-cols-[auto_1fr] gap-5 border-b border-[var(--color-line)] py-6 transition-colors hover:bg-[var(--color-ink-2)] sm:grid-cols-[7rem_1fr] sm:gap-8">
                <div class="flex flex-col gap-1">
                  <span
                    class="font-display text-3xl font-bold leading-none tracking-tight sm:text-4xl"
                    style={{
                      color: a.rank.startsWith("1")
                        ? "var(--color-signal)"
                        : a.rank.startsWith("3")
                          ? "var(--color-cyan)"
                          : "var(--color-fog)",
                    }}
                  >
                    {a.rank}
                  </span>
                  <span class="font-mono text-[0.625rem] tracking-[0.18em] text-[var(--color-line-2)] uppercase">{a.year}</span>
                </div>
                <div class="flex flex-col gap-1.5">
                  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                    <h3 class="font-display text-lg font-semibold tracking-tight text-[var(--color-chalk)]">{a.title}</h3>
                    {a.prize && (
                      <span class="border border-[var(--color-line-2)] px-2 py-0.5 font-mono text-[0.5625rem] tracking-[0.14em] text-[var(--color-signal)] uppercase">
                        {a.prize}
                      </span>
                    )}
                  </div>
                  <span class="font-mono text-[0.6875rem] tracking-[0.1em] text-[var(--color-fog)] uppercase">{a.org}</span>
                  <p class="text-sm leading-relaxed text-[var(--color-fog-2)]">{a.detail}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <!-- Certifications + communities -->
      <div class="flex flex-col gap-10">
        <div class="flex flex-col">
          <div class="mb-4 flex items-center justify-between border-b border-[var(--color-line)] pb-3">
            <span class="section-label">{t("sec.awards.certifications")}</span>
            <span class="section-index">{t("sec.awards.docs", { n: certifications.length })}</span>
          </div>

          <div class="flex flex-col gap-3">
            {
              certifications.map((c) => (
                <a
                  href={c.file}
                  target="_blank"
                  rel="noopener"
                  class="group flex items-start gap-4 border border-[var(--color-line)] p-5 no-underline transition-colors hover:border-[var(--color-signal)]"
                >
                  <span class="grid h-11 w-11 flex-none place-items-center border border-[var(--color-line-2)] font-mono text-[0.625rem] tracking-[0.1em] text-[var(--color-fog)] transition-colors group-hover:border-[var(--color-signal)] group-hover:text-[var(--color-signal)]">
                    PDF
                  </span>
                  <span class="flex flex-col gap-1">
                    <span class="font-display text-[0.95rem] font-semibold leading-snug text-[var(--color-chalk)]">{c.name}</span>
                    <span class="font-mono text-[0.625rem] tracking-[0.16em] text-[var(--color-fog)] uppercase">{c.issuer}</span>
                    <span class="text-sm leading-relaxed text-[var(--color-fog-2)]">{c.detail}</span>
                  </span>
                  <span class="ml-auto font-mono text-[var(--color-line-2)] transition-all group-hover:translate-x-1 group-hover:text-[var(--color-signal)]">
                    ↗
                  </span>
                </a>
              ))
            }
          </div>
        </div>

        <div class="flex flex-col">
          <div class="mb-4 flex items-center justify-between border-b border-[var(--color-line)] pb-3">
            <span class="section-label">{t("sec.awards.communities")}</span>
            <span class="section-index">Bahir Dar</span>
          </div>
          <div class="flex flex-wrap gap-2">
            {
              communities.map((c) =>
                c.href ? (
                  <a
                    href={c.href}
                    target="_blank"
                    rel="noopener"
                    class="border border-[var(--color-line)] px-3 py-2 font-mono text-[0.625rem] tracking-[0.14em] text-[var(--color-fog-2)] uppercase no-underline transition-colors hover:border-[var(--color-signal)] hover:text-[var(--color-signal)]"
                  >
                    {c.name} ↗
                  </a>
                ) : (
                  <span class="border border-[var(--color-line)] px-3 py-2 font-mono text-[0.625rem] tracking-[0.14em] text-[var(--color-fog)] uppercase">
                    {c.name}
                  </span>
                )
              )
            }
          </div>
        </div>

        <a class="btn btn-primary w-full" href="/assets/cv.pdf" download>{t("sec.awards.download")}</a>
      </div>
    </div>
  </div>
</section>
