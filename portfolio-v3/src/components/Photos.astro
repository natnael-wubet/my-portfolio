---
// Personal photos, straight from ./myphotos. No stock imagery, no fake captions.
// Seven tiles fill an 8-cell mobile grid (first tile spans both columns) and a
// 12-cell desktop mosaic: one 2×2 lead, one tall tile, one wide tile.
import { rich, type T } from "../i18n";

interface Props {
  t: T;
}
const { t } = Astro.props;

const photos = [
  { src: "/img/photo_2026-01-12_21-24-20.jpg", span: "col-span-2 lg:row-span-2", caption: "sec.photos.shot1" },
  { src: "/img/photo_2026-01-12_21-24-28.jpg", span: "lg:row-span-2", caption: "sec.photos.shot2" },
  { src: "/img/photo_2026-01-12_21-24-37.jpg", span: "", caption: "sec.photos.shot3" },
  { src: "/img/photo_2026-01-12_21-24-50.jpg", span: "", caption: "sec.photos.shot4" },
  { src: "/img/photo_2026-01-12_21-26-25.jpg", span: "", caption: "sec.photos.shot5" },
  { src: "/img/photo_xsw.jpg", span: "", caption: "sec.photos.shot6" },
  { src: "/img/photo_2026-02-20_22-20-15.jpg", span: "lg:col-span-2", caption: "sec.photos.shot7" },
];

const records = photos.map((p, i) => {
  const caption = t(p.caption);
  return {
    src: p.src,
    caption,
    alt: t("sec.photos.alt", { caption }),
    n: i + 1,
  };
});
const json = JSON.stringify(records).replace(/</g, "\\u003c");
const pad = (n: number) => String(n).padStart(2, "0");
---

<section id="photos" class="relative border-t border-[var(--color-line)]">
  <div class="shell py-24 lg:py-32">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div class="flex flex-col gap-5" data-reveal>
        <span class="eyebrow">{t("sec.photos.eyebrow")}</span>
        <h2 class="display display-lg" set:html={rich(t("sec.photos.title"))} />
      </div>
      <p class="max-w-sm text-sm leading-relaxed text-[var(--color-fog-2)]" data-reveal style="--d:120ms">
        {t("sec.photos.lead")}
      </p>
    </div>

    <div class="photo-grid mt-12" data-reveal>
      {
        records.map((p, i) => (
          <figure class={`photo-tile group m-0 ${photos[i].span}`} style={`--d:${(i % 4) * 80}ms`}>
            <img
              src={p.src}
              alt={p.alt}
              loading="lazy"
              decoding="async"
              width="640"
              height="640"
            />
            <span class="photo-shade" aria-hidden="true" />
            <span class="photo-index" aria-hidden="true">{pad(p.n)}</span>
            <figcaption class="photo-caption">
              <span class="photo-caption-text">{p.caption}</span>
              <span class="photo-caption-open">{t("sec.photos.view")} ↗</span>
            </figcaption>
            <button
              class="photo-open"
              type="button"
              data-photo={i}
              aria-label={t("sec.photos.open", { n: p.n, caption: p.caption })}
            />
          </figure>
        ))
      }
    </div>
  </div>
</section>

<dialog id="photo-dialog" class="pl" aria-labelledby="pl-caption">
  <div class="pl-shell">
    <header class="pl-top">
      <span class="pl-kicker">{t("sec.photos.lightbox")}</span>
      <span class="pl-counter" id="pl-counter">01 / {pad(records.length)}</span>
      <button class="pl-close" type="button" id="pl-close" aria-label={t("sec.photos.close")}>
        <span aria-hidden="true">✕</span>
      </button>
    </header>

    <div class="pl-stage" id="pl-stage">
      <img id="pl-image" alt="" decoding="async" />
      <button class="pl-nav pl-nav--prev" type="button" id="pl-prev" aria-label={t("sec.photos.prev")}>
        <span aria-hidden="true">←</span>
      </button>
      <button class="pl-nav pl-nav--next" type="button" id="pl-next" aria-label={t("sec.photos.next")}>
        <span aria-hidden="true">→</span>
      </button>
    </div>

    <footer class="pl-foot">
      <div class="pl-caption-row">
        <span class="pl-caption" id="pl-caption" aria-live="polite"></span>
        <span class="pl-archive">{t("sec.photos.archive")}</span>
      </div>

      <div class="pl-thumbs" role="group" aria-label={t("sec.photos.strip")}>
        {
          records.map((p, i) => (
            <button
              class="pl-thumb"
              type="button"
              data-thumb={i}
              aria-label={t("sec.photos.goTo", { n: p.n })}
            >
              <img src={p.src} alt="" width="640" height="640" loading="lazy" decoding="async" />
            </button>
          ))
        }
      </div>

      <span class="pl-hint">{t("sec.photos.hint")}</span>
    </footer>
  </div>
</dialog>

<script type="application/json" id="photo-data" set:html={json} />

<script>
  const dialog = document.getElementById("photo-dialog") as HTMLDialogElement | null;
  const data = document.getElementById("photo-data")?.textContent ?? "[]";
  const photos = JSON.parse(data) as Array<{ src: string; caption: string; alt: string; n: number }>;

  if (dialog && photos.length) {
    const $ = <E extends HTMLElement>(id: string) => document.getElementById(id) as E;
    const stage = $("pl-stage");
    const image = $<HTMLImageElement>("pl-image");
    const caption = $("pl-caption");
    const counter = $("pl-counter");
    const closeButton = $<HTMLButtonElement>("pl-close");
    const thumbs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-thumb]"));

    const pad = (n: number) => String(n).padStart(2, "0");
    let index = 0;
    let lastTrigger: HTMLElement | null = null;

    const preload = (at: number) => {
      const record = photos[(at + photos.length) % photos.length];
      if (!record) return;
      const next = new Image();
      next.src = record.src;
    };

    const render = (nextIndex: number) => {
      index = (nextIndex + photos.length) % photos.length;
      const record = photos[index];

      image.src = record.src;
      image.alt = record.alt;
      stage.style.setProperty("--pl-photo", `url("${record.src}")`);
      caption.textContent = record.caption;
      counter.textContent = `${pad(record.n)} / ${pad(photos.length)}`;

      thumbs.forEach((thumb, i) => {
        thumb.setAttribute("aria-current", i === index ? "true" : "false");
      });

      stage.classList.remove("is-swapping");
      void stage.offsetWidth;
      stage.classList.add("is-swapping");

      preload(index - 1);
      preload(index + 1);
    };

    const open = (at: number, trigger: HTMLElement | null) => {
      lastTrigger = trigger;
      document.documentElement.classList.add("photo-open");
      (window as any).lenis?.stop?.();
      dialog.showModal();
      render(at);
      closeButton.focus();
    };

    const close = () => dialog.close();

    dialog.addEventListener("close", () => {
      document.documentElement.classList.remove("photo-open");
      (window as any).lenis?.start?.();
      lastTrigger?.focus();
      lastTrigger = null;
    });

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) close();
    });

    closeButton.addEventListener("click", close);
    $("pl-prev").addEventListener("click", () => render(index - 1));
    $("pl-next").addEventListener("click", () => render(index + 1));

    thumbs.forEach((thumb, i) => {
      thumb.addEventListener("click", () => render(i));
    });

    dialog.addEventListener("keydown", (event) => {
      if (event.key === "ArrowRight") {
        event.preventDefault();
        render(index + 1);
      } else if (event.key === "ArrowLeft") {
        event.preventDefault();
        render(index - 1);
      } else if (event.key === "Home") {
        event.preventDefault();
        render(0);
      } else if (event.key === "End") {
        event.preventDefault();
        render(photos.length - 1);
      }
    });

    // Swipe between photos on touch screens.
    let startX: number | null = null;
    stage.addEventListener("pointerdown", (event) => {
      if (event.pointerType === "mouse") return;
      startX = event.clientX;
    });
    stage.addEventListener("pointerup", (event) => {
      if (startX === null) return;
      const dx = event.clientX - startX;
      startX = null;
      if (Math.abs(dx) < 42) return;
      render(index + (dx < 0 ? 1 : -1));
    });
    stage.addEventListener("pointercancel", () => {
      startX = null;
    });

    document.querySelectorAll<HTMLButtonElement>("[data-photo]").forEach((trigger) => {
      trigger.addEventListener("click", () => {
        open(Number(trigger.dataset.photo ?? 0), trigger);
      });
    });
  }
</script>

<style>
  /* ── Mosaic ─────────────────────────────────────────────── */
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 12rem;
    gap: 1px;
    background: var(--color-line);
  }

  @media (min-width: 1024px) {
    .photo-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: 15rem;
    }
  }

  .photo-tile {
    position: relative;
    overflow: hidden;
    background: var(--color-ink-3);
  }

  .photo-tile::after {
    content: "";
    position: absolute;
    inset: 0;
    border: 1px solid transparent;
    transition: border-color 0.4s ease;
    pointer-events: none;
    z-index: 2;
  }

  .photo-tile:hover::after,
  .photo-tile:focus-within::after {
    border-color: var(--color-signal);
  }

  .photo-tile img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.08);
    transition: filter 0.6s ease, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .photo-tile:hover img,
  .photo-tile:focus-within img {
    filter: grayscale(0) contrast(1);
    transform: scale(1.04);
  }

  .photo-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(8, 9, 10, 0.82), transparent 46%);
    opacity: 0;
    transition: opacity 0.45s ease;
    pointer-events: none;
  }

  .photo-tile:hover .photo-shade,
  .photo-tile:focus-within .photo-shade {
    opacity: 1;
  }

  .photo-index {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    z-index: 1;
    padding: 0.15rem 0.4rem;
    background: rgba(8, 9, 10, 0.66);
    color: rgba(238, 241, 244, 0.78);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.14em;
    backdrop-filter: blur(4px);
  }

  .photo-caption {
    position: absolute;
    inset: auto 0 0;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.8rem 0.9rem;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.4s ease, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
  }

  .photo-tile:hover .photo-caption,
  .photo-tile:focus-within .photo-caption {
    opacity: 1;
    transform: none;
  }

  .photo-caption-text {
    color: #eef1f4;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.14em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .photo-caption-open {
    flex: none;
    color: var(--color-signal);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .photo-open {
    position: absolute;
    inset: 0;
    z-index: 3;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: zoom-in;
  }

  .photo-open:focus-visible {
    outline: 2px solid var(--color-signal);
    outline-offset: -4px;
  }

  /* On touch screens there is no hover: show colour and captions outright. */
  @media (hover: none) {
    .photo-tile img {
      filter: grayscale(0) contrast(1);
    }

    .photo-shade,
    .photo-caption {
      opacity: 1;
      transform: none;
    }

    .photo-caption-open {
      display: none;
    }
  }

  /* ── Lightbox ───────────────────────────────────────────── */
  .pl {
    width: min(1080px, calc(100vw - 2rem));
    max-width: none;
    max-height: calc(100dvh - 2rem);
    margin: auto;
    padding: 0;
    border: 1px solid var(--color-line-2);
    background: var(--color-ink);
    color: var(--color-chalk);
    overflow: hidden;
  }

  .pl::backdrop {
    background: rgba(5, 6, 7, 0.86);
    backdrop-filter: blur(14px) saturate(0.9);
  }

  .pl[open] {
    animation: pl-in 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes pl-in {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.99);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .pl-shell {
    display: flex;
    flex-direction: column;
    max-height: inherit;
    background: var(--color-ink);
  }

  .pl-top {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-line);
  }

  .pl-kicker,
  .pl-counter,
  .pl-archive,
  .pl-hint {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .pl-kicker {
    color: var(--color-signal);
  }

  .pl-counter {
    color: var(--color-fog);
    font-variant-numeric: tabular-nums;
  }

  .pl-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    margin-left: auto;
    border: 1px solid var(--color-line);
    background: transparent;
    color: var(--color-fog-2);
    font-size: 0.8rem;
    cursor: pointer;
    transition: border-color 0.2s ease, background-color 0.2s ease, color 0.2s ease;
  }

  .pl-close:hover,
  .pl-close:focus-visible {
    border-color: var(--color-chalk);
    background: var(--color-chalk);
    color: var(--color-ink);
  }

  .pl-stage {
    position: relative;
    display: grid;
    place-items: center;
    flex: 1;
    min-height: 0;
    padding: 1rem;
    background:
      radial-gradient(80% 70% at 50% 40%, rgba(38, 42, 47, 0.6), transparent 72%),
      #08090a;
    touch-action: pan-y;
  }

  .pl-stage::before {
    content: "";
    position: absolute;
    inset: -2rem;
    background-image: var(--pl-photo);
    background-position: center;
    background-size: cover;
    filter: blur(48px) saturate(1.15);
    opacity: 0.42;
    pointer-events: none;
  }

  .pl-stage::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(8, 9, 10, 0.35), rgba(8, 9, 10, 0.55));
    pointer-events: none;
  }

  .pl-stage img {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: auto;
    max-height: min(66dvh, 720px);
    object-fit: contain;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.55);
  }

  .pl-stage.is-swapping img {
    animation: pl-shot 0.28s ease;
  }

  @keyframes pl-shot {
    from {
      opacity: 0.35;
      transform: scale(0.995);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .pl-nav {
    position: absolute;
    z-index: 2;
    top: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.9rem;
    height: 2.9rem;
    border: 1px solid rgba(238, 241, 244, 0.22);
    background: rgba(8, 9, 10, 0.58);
    color: #eef1f4;
    font-size: 1.1rem;
    cursor: pointer;
    transform: translateY(-50%);
    backdrop-filter: blur(6px);
    transition: border-color 0.2s ease, background-color 0.2s ease, color 0.2s ease;
  }

  .pl-nav:hover,
  .pl-nav:focus-visible {
    border-color: var(--color-signal);
    background: var(--color-signal);
    color: var(--color-on-signal);
  }

  .pl-nav--prev {
    left: 0.75rem;
  }

  .pl-nav--next {
    right: 0.75rem;
  }

  .pl-foot {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: 0.85rem 1rem 1rem;
    border-top: 1px solid var(--color-line);
  }

  .pl-caption-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .pl-caption {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-chalk);
  }

  .pl-archive {
    flex: none;
    color: var(--color-fog);
    letter-spacing: 0.12em;
  }

  .pl-thumbs {
    display: flex;
    gap: 0.35rem;
    overflow-x: auto;
    padding-bottom: 0.15rem;
    scrollbar-width: thin;
  }

  .pl-thumb {
    flex: none;
    width: 3.1rem;
    height: 3.1rem;
    padding: 0;
    border: 1px solid var(--color-line);
    background: var(--color-ink-3);
    cursor: pointer;
    opacity: 0.55;
    transition: opacity 0.25s ease, border-color 0.25s ease;
  }

  .pl-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pl-thumb:hover,
  .pl-thumb:focus-visible {
    opacity: 0.85;
    border-color: var(--color-line-2);
  }

  .pl-thumb[aria-current="true"] {
    opacity: 1;
    border-color: var(--color-signal);
  }

  .pl-thumb:focus-visible {
    outline: 1px solid var(--color-signal);
    outline-offset: 2px;
  }

  .pl-hint {
    color: var(--color-fog);
    letter-spacing: 0.1em;
  }

  :global(html.photo-open),
  :global(html.photo-open body) {
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .pl {
      width: 100vw;
      max-height: 100dvh;
      height: 100dvh;
      border: 0;
    }

    .pl-shell {
      height: 100%;
    }

    .pl-stage {
      padding: 0.5rem;
    }

    .pl-stage img {
      max-height: 58dvh;
    }

    .pl-nav {
      width: 2.5rem;
      height: 2.5rem;
    }

    .pl-nav--prev {
      left: 0.4rem;
    }

    .pl-nav--next {
      right: 0.4rem;
    }

    .pl-archive {
      display: none;
    }

    .pl-hint {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pl[open],
    .pl-stage.is-swapping img {
      animation: none;
    }

    .photo-tile::after,
    .photo-tile img,
    .photo-shade,
    .photo-caption,
    .pl-close,
    .pl-nav,
    .pl-thumb {
      transition: none;
    }

    .photo-tile:hover img,
    .photo-tile:focus-within img {
      transform: none;
    }
  }
</style>
