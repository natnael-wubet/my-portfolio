---
// Personal photos — straight from ./myphotos. No stock imagery, no fake captions.
// Personal photos from ./myphotos — all 640×640 squares.
// Seven tiles, first one spanning two columns: 8 cells total, which divides
// evenly into both the 2-col mobile grid (4 rows) and the 4-col desktop grid
// (2 rows), so there is never an empty cell.
const photos = [
  { src: "/img/photo_2026-01-12_21-24-20.jpg", span: "col-span-2" },
  { src: "/img/photo_2026-01-12_21-24-28.jpg", span: "" },
  { src: "/img/photo_2026-01-12_21-24-37.jpg", span: "" },
  { src: "/img/photo_2026-01-12_21-24-50.jpg", span: "" },
  { src: "/img/photo_2026-01-12_21-26-25.jpg", span: "" },
  { src: "/img/photo_xsw.jpg", span: "" },
  { src: "/img/photo_2026-02-20_22-20-15.jpg", span: "" },
];
---

<section id="photos" class="relative border-t border-[--color-line]">
  <div class="shell py-24 lg:py-32">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div class="flex flex-col gap-5">
        <span class="eyebrow">Off-screen · personal</span>
        <h2 class="display display-lg">The person,<br />not the profile</h2>
      </div>
      <p class="max-w-sm text-sm text-[--color-fog-2]">
        Personal photos, no retouching. They start in grayscale and come back to colour on hover — the same rule as
        everything else here: you only get the signal when you go looking for it.
      </p>
    </div>

    {/* 8 cells (7 tiles, first spans 2 columns) divides evenly by 2 and by 4.
        Row height is set explicitly rather than via aspect-ratio: a 2-col-wide
        tile with aspect-square would become twice as tall as its neighbours and
        strand an empty cell beside it. */}
    <div class="mt-12 grid grid-cols-2 auto-rows-[12rem] gap-px bg-[--color-line] lg:grid-cols-4 lg:auto-rows-[17rem]">
      {
        photos.map((p, i) => (
          <figure class={`photo-tile ${p.span} m-0 h-full w-full`}>
            <img
              src={p.src}
              alt={`Natnael Wubet — personal photo ${i + 1}`}
              loading="lazy"
              decoding="async"
              width="640"
              height="640"
            />
            <figcaption class="pointer-events-none absolute inset-x-0 bottom-0 flex items-end justify-between bg-gradient-to-t from-black/80 to-transparent p-3 opacity-0 transition-opacity duration-500 group-hover:opacity-100">
              <span class="font-mono text-[0.5625rem] tracking-[0.2em] text-white/75 uppercase">
                Natnael Wubet
              </span>
              <span class="font-mono text-[0.5625rem] tracking-[0.2em] text-[--color-signal]">
                {String(i + 1).padStart(2, "0")}
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
