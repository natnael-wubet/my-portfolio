---
/**
 * Site instrument: the small always-available measurement layer.
 *
 *   ui:toast   detail: string      → transient status line
 *   opt:diag                       → toggle the diagnostics drawer
 *   opt:xray                       → toggle X-ray mode (see below)
 *
 * The panel measures the page in the visitor's own browser: navigation
 * timings, transfer weight, viewport, connection, JS heap and live frame
 * rate. Build provenance comes from the commit at build time, so "Build"
 * means exactly that.
 */
import type { T } from "../i18n";
import type { BuildInfo } from "../lib/build";

interface Props {
  t: T;
  build: BuildInfo;
}
const { t, build } = Astro.props;

const buildLabel = `${build.commit} · ${build.time.slice(0, 16).replace("T", " ")}`;

const rows = [
  ["diag.build", "build"],
  ["diag.language", "language"],
  ["diag.theme", "theme"],
  ["diag.accent", "accent"],
  ["diag.viewport", "viewport"],
  ["diag.dpr", "dpr"],
  ["diag.connection", "connection"],
  ["diag.ttfb", "ttfb"],
  ["diag.dom", "dom"],
  ["diag.load", "load"],
  ["diag.weight", "weight"],
  ["diag.requests", "requests"],
  ["diag.heap", "heap"],
  ["diag.scroll", "scroll"],
  ["diag.clock", "clock"],
] as const;

// Tokens shown in the X-ray strip. Reading them at runtime means the strip
// always reflects the active theme and accent, not a hardcoded palette.
const xrayTokens = [
  "--color-signal",
  "--color-chalk",
  "--color-fog",
  "--color-fog-2",
  "--color-line",
  "--color-line-2",
  "--color-ink",
  "--color-ink-2",
  "--color-ink-3",
  "--color-cyan",
  "--color-amber",
  "--color-rose",
];
---

<!-- Shared transient feedback for copy/share actions. -->
<div class="site-toast" id="site-toast" role="status" aria-live="polite"></div>

<!-- Diagnostics trigger: a tiny instrument chip, bottom-left. -->
<button
  class="diag-chip"
  id="diag-trigger"
  type="button"
  aria-controls="diag-panel"
  aria-expanded="false"
>
  <span class="diag-chip-dot" aria-hidden="true"></span>
  <span>{t("diag.chip")}</span>
  <kbd>D</kbd>
</button>

<aside class="diag-panel" id="diag-panel" aria-label={t("diag.title")} aria-hidden="true">
  <div class="diag-head">
    <span class="diag-title">{t("diag.title")}</span>
    <button class="diag-close" id="diag-close" type="button" aria-label={t("diag.close")}>×</button>
  </div>
  <p class="diag-sub">{t("diag.sub")}</p>

  <div class="diag-rows">
    {
      rows.map(([label, id]) => (
        <div class="diag-row">
          <span class="diag-label">{t(label)}</span>
          <b class="diag-value" data-diag={id}>{id === "build" ? buildLabel : "n/a"}</b>
        </div>
      ))
    }
  </div>

  <div class="diag-spark">
    <div class="diag-spark-head">
      <span class="diag-label">{t("diag.fps")}</span>
      <b class="diag-value" data-diag="fps">n/a</b>
    </div>
    <canvas id="diag-spark" width="240" height="40" aria-hidden="true"></canvas>
  </div>
</aside>

<!-- X-ray: what the layout is actually made of. -->
<div class="xray" id="xray" aria-hidden="true" data-on={t("ui.xrayOn")} data-off={t("ui.xrayOff")}>
  <div class="xray-cols"></div>
  <div class="xray-hud">
    <div class="xray-hud-head">
      <span class="xray-title">{t("diag.xray")}</span>
      <span class="xray-hint"><kbd>I</kbd> {t("diag.close")}</span>
    </div>
    <div class="xray-tokens" id="xray-tokens" data-tokens={JSON.stringify(xrayTokens)}></div>
  </div>
</div>

<script>
  const root = document.documentElement;
  const panel = document.getElementById("diag-panel") as HTMLElement | null;
  const trigger = document.getElementById("diag-trigger") as HTMLButtonElement | null;
  const closeBtn = document.getElementById("diag-close") as HTMLButtonElement | null;
  const spark = document.getElementById("diag-spark") as HTMLCanvasElement | null;
  const locale = root.lang === "am" ? "am-ET" : "en-GB";
  const DASH = "n/a";

  let open = false;
  let raf = 0;
  let ticker = 0;
  let frames = 0;
  const history: number[] = [];

  const set = (name: string, text: string) => {
    const el = panel?.querySelector<HTMLElement>(`[data-diag="${name}"]`);
    if (el) el.textContent = text;
  };

  const bytes = (n: number) =>
    n >= 1048576 ? `${(n / 1048576).toFixed(1)} MB` : `${Math.max(1, Math.round(n / 1024))} KB`;

  const measureStatic = () => {
    const nav = performance.getEntriesByType("navigation")[0] as PerformanceNavigationTiming | undefined;
    const res = performance.getEntriesByType("resource") as PerformanceResourceTiming[];

    set("ttfb", nav ? `${Math.round(nav.responseStart)} ms` : DASH);
    set("dom", nav ? `${Math.round(nav.domContentLoadedEventEnd - nav.startTime)} ms` : DASH);
    set("load", nav && nav.loadEventEnd > 0 ? `${Math.round(nav.loadEventEnd - nav.startTime)} ms` : DASH);

    const transfer = res.reduce((sum, r) => sum + (r.transferSize || 0), nav?.transferSize ?? 0);
    set("weight", transfer ? bytes(transfer) : DASH);
    set("requests", String(res.length + (nav ? 1 : 0)));

    set("viewport", `${window.innerWidth} × ${window.innerHeight}`);
    set("dpr", `${window.devicePixelRatio}×`);
    set("theme", root.dataset.theme ?? DASH);
    set("accent", root.dataset.accent ?? DASH);
    set("language", root.lang || DASH);

    const conn = (
      navigator as Navigator & {
        connection?: { effectiveType?: string; downlink?: number; rtt?: number };
      }
    ).connection;
    set(
      "connection",
      conn
        ? [
            conn.effectiveType,
            conn.downlink != null ? `${conn.downlink} Mb/s` : null,
            conn.rtt != null ? `${conn.rtt} ms` : null,
          ]
            .filter(Boolean)
            .join(" · ")
        : DASH
    );

    const mem = (performance as Performance & { memory?: { usedJSHeapSize: number; jsHeapSizeLimit: number } })
      .memory;
    set(
      "heap",
      mem
        ? `${(mem.usedJSHeapSize / 1048576).toFixed(1)} / ${(mem.jsHeapSizeLimit / 1048576).toFixed(0)} MB`
        : DASH
    );
  };

  const color = (name: string) => getComputedStyle(root).getPropertyValue(name).trim();

  const drawSpark = () => {
    if (!spark) return;
    const ctx = spark.getContext("2d");
    if (!ctx) return;
    const w = spark.width;
    const h = spark.height;

    ctx.clearRect(0, 0, w, h);
    ctx.strokeStyle = color("--color-line-2");
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(0, h - 1);
    ctx.lineTo(w, h - 1);
    ctx.stroke();

    if (history.length < 2) return;
    ctx.strokeStyle = color("--color-signal");
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    history.forEach((fps, i) => {
      const x = (i / Math.max(history.length - 1, 1)) * (w - 2) + 1;
      const y = h - 2 - (Math.min(fps, 120) / 120) * (h - 6);
      i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
    });
    ctx.stroke();
  };

  const measureLive = () => {
    const max = document.documentElement.scrollHeight - window.innerHeight;
    set("scroll", `${Math.round(max > 0 ? (window.scrollY / max) * 100 : 0)}%`);
    set(
      "clock",
      `${new Date().toLocaleTimeString(locale, {
        timeZone: "Africa/Addis_Ababa",
        hour12: false,
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
      })} EAT`
    );
  };

  const tick = () => {
    const fps = frames;
    frames = 0;
    set("fps", `${fps} fps`);
    history.push(fps);
    if (history.length > 32) history.shift();
    drawSpark();
    measureLive();
  };

  const loop = () => {
    frames++;
    raf = requestAnimationFrame(loop);
  };

  const show = () => {
    if (!panel || open) return;
    open = true;
    panel.classList.add("open");
    panel.setAttribute("aria-hidden", "false");
    trigger?.setAttribute("aria-expanded", "true");
    frames = 0;
    measureStatic();
    measureLive();
    drawSpark();
    raf = requestAnimationFrame(loop);
    ticker = window.setInterval(tick, 1000);
    closeBtn?.focus();
  };

  const hide = () => {
    if (!panel || !open) return;
    open = false;
    panel.classList.remove("open");
    panel.setAttribute("aria-hidden", "true");
    trigger?.setAttribute("aria-expanded", "false");
    cancelAnimationFrame(raf);
    window.clearInterval(ticker);
    trigger?.focus();
  };

  trigger?.addEventListener("click", () => (open ? hide() : show()));
  closeBtn?.addEventListener("click", hide);
  document.addEventListener("opt:diag", () => (open ? hide() : show()));

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && open) hide();
  });

  // Clicking anywhere outside the drawer dismisses it, like a popover.
  document.addEventListener("pointerdown", (e) => {
    if (!open) return;
    const node = e.target as Node;
    if (panel?.contains(node) || trigger?.contains(node)) return;
    hide();
  });

  document.addEventListener("theme:change", () => {
    if (open) {
      measureStatic();
      drawSpark();
    }
    if (xrayOn) paintTokens();
  });
  document.addEventListener("accent:change", () => {
    if (open) {
      measureStatic();
      drawSpark();
    }
    if (xrayOn) paintTokens();
  });

  // ── X-ray ────────────────────────────────────────────────
  //    Renders the scaffolding the design is built on: the 12-column shell,
  //    one outline per section, the id of each region, and the live colour
  //    tokens. It is a debug instrument, not decoration, so it is off by
  //    default, remembered per tab, and driven by the same event bus.
  const xray = document.getElementById("xray") as HTMLElement | null;
  const xrayTokensEl = document.getElementById("xray-tokens") as HTMLElement | null;
  const tokenNames: string[] = JSON.parse(xrayTokensEl?.dataset.tokens ?? "[]");
  let xrayOn = false;

  const paintTokens = () => {
    if (!xrayTokensEl) return;
    xrayTokensEl.replaceChildren(
      ...tokenNames.map((name) => {
        const value = getComputedStyle(root).getPropertyValue(name).trim();
        const row = document.createElement("div");
        row.className = "xray-token";
        const swatch = document.createElement("i");
        swatch.style.background = value || "transparent";
        const label = document.createElement("span");
        label.textContent = name;
        const code = document.createElement("b");
        code.textContent = value || "n/a";
        row.append(swatch, label, code);
        return row;
      })
    );
  };

  const setXray = (next: boolean, announce = true) => {
    if (next === xrayOn) return;
    xrayOn = next;
    root.toggleAttribute("data-xray", xrayOn);
    try {
      sessionStorage.setItem("cv:xray", xrayOn ? "1" : "0");
    } catch {
      /* private mode, the toggle still works for this page */
    }
    if (xrayOn) paintTokens();
    if (announce && xray) {
      document.dispatchEvent(
        new CustomEvent("ui:toast", { detail: (xrayOn ? xray.dataset.on : xray.dataset.off) ?? "" })
      );
    }
  };

  document.addEventListener("opt:xray", (e) => {
    const detail = (e as CustomEvent<boolean | undefined>).detail;
    setXray(typeof detail === "boolean" ? detail : !xrayOn);
  });

  try {
    setXray(sessionStorage.getItem("cv:xray") === "1", false);
  } catch {
    /* no session storage */
  }
</script>

<style>
  .site-toast {
    position: fixed;
    left: 50%;
    bottom: 2rem;
    z-index: 300;
    transform: translate(-50%, 1rem);
    opacity: 0;
    pointer-events: none;
    border: 1px solid var(--color-line-2);
    background: var(--color-ink-2);
    color: var(--color-chalk);
    padding: 0.6rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .site-toast.show {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  /* ── Trigger chip ─────────────────────────────────────────── */
  .diag-chip {
    position: fixed;
    left: 1rem;
    bottom: 1rem;
    z-index: 140;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.6rem;
    border: 1px solid var(--color-line);
    background: color-mix(in srgb, var(--color-ink) 88%, transparent);
    backdrop-filter: blur(8px);
    color: var(--color-fog);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .diag-chip:hover,
  .diag-chip[aria-expanded="true"] {
    border-color: var(--color-signal);
    color: var(--color-chalk);
  }

  .diag-chip-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--color-signal);
    box-shadow: 0 0 8px var(--color-signal);
  }

  .diag-chip kbd {
    border: 1px solid var(--color-line-2);
    padding: 0 0.25rem;
    font: inherit;
    font-size: 0.5625rem;
    color: var(--color-fog-2);
  }

  /* ── Drawer ───────────────────────────────────────────────── */
  .diag-panel {
    position: fixed;
    inset: 0 0 0 auto;
    z-index: 260;
    width: min(400px, 100vw);
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.2rem 1.25rem 1.5rem;
    overflow-y: auto;
    background: var(--color-ink-2);
    border-left: 1px solid var(--color-line-2);
    box-shadow: -30px 0 90px -50px color-mix(in srgb, #000 55%, transparent);
    transform: translateX(100%);
    visibility: hidden;
    transition:
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0.35s;
  }

  .diag-panel.open {
    transform: none;
    visibility: visible;
  }

  .diag-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .diag-title {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-signal);
  }

  .diag-close {
    margin-left: auto;
    width: 1.6rem;
    height: 1.6rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--color-line-2);
    background: transparent;
    color: var(--color-fog-2);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1;
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .diag-close:hover {
    border-color: var(--color-signal);
    color: var(--color-chalk);
  }

  .diag-sub {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    color: var(--color-fog);
  }

  .diag-rows {
    display: flex;
    flex-direction: column;
  }

  .diag-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.42rem 0;
    border-bottom: 1px dotted var(--color-line);
  }

  .diag-label {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-fog);
    white-space: nowrap;
  }

  .diag-value {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--color-chalk);
    text-align: right;
    font-variant-numeric: tabular-nums;
    word-break: break-word;
  }

  .diag-spark {
    margin-top: auto;
    border-top: 1px solid var(--color-line);
    padding-top: 0.75rem;
  }

  .diag-spark-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }

  .diag-spark canvas {
    display: block;
    width: 100%;
    height: 40px;
  }

  @media (prefers-reduced-motion: reduce) {
    .diag-panel {
      transition: none;
    }
  }

  @media print {
    .diag-chip,
    .diag-panel,
    .site-toast {
      display: none !important;
    }
  }
</style>

<style is:global>
  /*
   * X-ray mode. Everything here is gated behind html[data-xray], so the
   * normal page pays nothing but a few unused rules. It is deliberately
   * global: it needs to reach main > section, header and footer.
   */
  .xray {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 130;
    pointer-events: none;
  }

  html[data-xray] .xray {
    display: block;
  }

  /* The shell's 12 columns, drawn where the content actually sits. */
  .xray-cols {
    position: absolute;
    inset: 0;
    max-width: 1560px;
    margin-inline: auto;
  }

  .xray-cols::before {
    content: "";
    position: absolute;
    inset-block: 0;
    left: clamp(1.25rem, 4vw, 4rem);
    right: clamp(1.25rem, 4vw, 4rem);
    background-image: linear-gradient(
      to right,
      color-mix(in srgb, var(--color-signal) 30%, transparent) 1px,
      transparent 1px
    );
    background-size: calc(100% / 12) 100%;
    opacity: 0.6;
  }

  /* 8px baseline, faint enough to read type against. */
  .xray-cols::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-line-2) 50%, transparent) 1px,
      transparent 1px
    );
    background-size: 100% 8px;
    opacity: 0.18;
  }

  /* Outlines around the page's real regions. */
  html[data-xray] main > section[id],
  html[data-xray] header#nav,
  html[data-xray] footer {
    outline: 1px dashed color-mix(in srgb, var(--color-signal) 65%, transparent);
    outline-offset: -1px;
  }

  html[data-xray] .rule-grid {
    opacity: 1;
  }

  /* Region ids, in the instrument's own type. */
  html[data-xray] main > section[id]::after,
  html[data-xray] header#nav::after,
  html[data-xray] footer::after {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 20;
    padding: 0.15rem 0.4rem;
    background: var(--color-signal);
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    pointer-events: none;
  }

  html[data-xray] main > section[id]::after,
  html[data-xray] header#nav::after {
    content: "#" attr(id);
  }

  html[data-xray] header#nav::after {
    top: auto;
    bottom: 0;
  }

  html[data-xray] footer::after {
    content: "footer";
  }

  /* Token strip: name, live value, swatch, read from the cascade. */
  .xray-hud {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    width: min(360px, calc(100vw - 2rem));
    border: 1px solid var(--color-line-2);
    background: color-mix(in srgb, var(--color-ink) 92%, transparent);
    backdrop-filter: blur(10px);
    padding: 0.75rem 0.85rem;
    font-family: var(--font-mono);
  }

  .xray-hud-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-line);
  }

  .xray-title {
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-signal);
  }

  .xray-hint {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-fog);
  }

  .xray-hint kbd {
    border: 1px solid var(--color-line-2);
    padding: 0 0.25rem;
    font: inherit;
    color: var(--color-fog-2);
  }

  .xray-tokens {
    display: flex;
    flex-direction: column;
    margin-top: 0.35rem;
  }

  .xray-token {
    display: grid;
    grid-template-columns: 0.7rem 1fr auto;
    align-items: center;
    gap: 0.5rem;
    padding: 0.18rem 0;
    font-size: 0.5625rem;
    color: var(--color-fog-2);
  }

  .xray-token i {
    width: 0.7rem;
    height: 0.7rem;
    border: 1px solid var(--color-line-2);
  }

  .xray-token b {
    font-weight: 500;
    color: var(--color-chalk);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 640px) {
    .xray-hud {
      display: none;
    }
  }
</style>
