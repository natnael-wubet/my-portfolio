---
import { cvPages } from "../data/content";
---

<section id="vault" class="relative border-t border-[var(--color-line)]">
  <div class="shell py-24 lg:py-32">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div class="flex flex-col gap-5">
        <span class="eyebrow">Section 04 · The Vault</span>
        <h2 class="display display-lg">Every page,<br />in three dimensions</h2>
        <p class="max-w-xl text-[var(--color-fog-2)]">
          These frames are the actual rendered pages of <span class="text-[var(--color-chalk)]">cv.pdf</span>, extracted from the
          source document and mapped onto a volumetric carousel. Drag to rotate.
        </p>
      </div>
      <div class="flex flex-col items-start gap-3 md:items-end">
        <div class="flex items-center gap-3 font-mono text-[0.6875rem] tracking-[0.2em] text-[var(--color-fog)] uppercase">
          <span class="status" data-state="live"><span class="status-dot"></span>WebGL</span>
          <span id="vault-counter">01 / {String(cvPages.length).padStart(2, "0")}</span>
        </div>
        <a class="btn btn-sm" href="/assets/cv.pdf" download>Download PDF</a>
      </div>
    </div>
  </div>

  <div class="relative h-[min(78vh,720px)] w-full">
    <!-- soft stage glow so the ring sits in a lit volume rather than a void -->
    <div
      class="pointer-events-none absolute inset-0"
      aria-hidden="true"
      style="background: radial-gradient(ellipse 62% 52% at 50% 58%, color-mix(in srgb, var(--color-signal) 5.5%, transparent) 0%, color-mix(in srgb, var(--color-cyan) 3%, transparent) 42%, transparent 72%);"
    ></div>
    <canvas id="vault-canvas" class="vault-canvas relative" data-pages={JSON.stringify(cvPages)}></canvas>
    <div class="pointer-events-none absolute inset-0 flex items-end justify-center pb-8">
      <div class="flex items-center gap-4 font-mono text-[0.625rem] tracking-[0.3em] text-[var(--color-fog)] uppercase">
        <span class="hidden sm:inline">Drag</span>
        <span class="h-px w-10 bg-[var(--color-line-2)]"></span>
        <span id="vault-hint">Scroll to advance</span>
        <span class="h-px w-10 bg-[var(--color-line-2)]"></span>
        <span class="hidden sm:inline">Rotate</span>
      </div>
    </div>
  </div>
</section>

<script>
  import * as THREE from "three";

  const canvas = document.getElementById("vault-canvas") as HTMLCanvasElement | null;
  const section = document.getElementById("vault") as HTMLElement | null;
  const counter = document.getElementById("vault-counter") as HTMLElement | null;

  // Page list rides on the canvas as JSON — avoids define:vars, which would
  // downgrade this to a classic script and break the `import` above.
  const pageList: string[] = canvas?.dataset.pages ? JSON.parse(canvas.dataset.pages) : [];

  if (canvas && section && counter && pageList.length) {
    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setClearColor(0x000000, 0);
    renderer.outputColorSpace = THREE.SRGBColorSpace;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(42, 1, 0.1, 100);
    camera.position.set(0, 0.35, 12.5);
    camera.lookAt(0, -0.35, 0);

    // ── Lights ───────────────────────────────────────────
    // Pages are lit mostly by their own emissive map (below) so text stays
    // legible from any angle; the coloured lights only add shape and tint.
    scene.add(new THREE.AmbientLight(0xffffff, 1.6));

    // Tints read from the CSS tokens so the stage follows theme + accent.
    const cssColor = (name: string, fallback: string) => {
      const v = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
      return new THREE.Color(v || fallback);
    };
    const key = new THREE.DirectionalLight(cssColor("--color-signal", "#d4ff3f"), 1.4);
    key.position.set(4, 5, 6);
    scene.add(key);
    const rim = new THREE.DirectionalLight(cssColor("--color-cyan", "#34d3e0"), 1.1);
    rim.position.set(-5, -2, -4);
    scene.add(rim);

    // ── Ring of textured planes ──────────────────────────
    const group = new THREE.Group();
    scene.add(group);

    const loader = new THREE.TextureLoader();
    const radius = 6.4;
    const step = (Math.PI * 2) / pageList.length;

    // CV frames are a mix of portrait and landscape, so each panel is sized to
    // its own texture instead of forcing one aspect ratio over all of them.
    const MAX_H = 3.0;
    const MAX_W = 4.0;
    const sizeFor = (aspect: number): [number, number] =>
      aspect < 1 ? [MAX_H * aspect, MAX_H] : [MAX_W, MAX_W / aspect];

    // Texture fetch is split out so it can be deferred: the eight CV frames
    // are ~640KB of JPEG, and there is no reason to make every visitor
    // download them before they have scrolled anywhere near the vault.
    const fetchTexture = (src: string, mat: THREE.MeshStandardMaterial, mesh: THREE.Mesh) => {
      loader.load(
        src,
        (tex) => {
          tex.colorSpace = THREE.SRGBColorSpace;
          tex.anisotropy = renderer.capabilities.getMaxAnisotropy();
          mat.map = tex;
          // Self-lit: the page reads as a lit document instead of a dark card
          // catching whatever the directional lights happen to point at.
          mat.emissive.set(0xffffff);
          mat.emissiveMap = tex;
          mat.emissiveIntensity = 0.62;
          mat.color.set(0xffffff);
          mat.needsUpdate = true;
          const [w, h] = sizeFor((tex.image?.width ?? 1) / (tex.image?.height ?? 1));
          mesh.geometry.dispose();
          mesh.geometry = new THREE.PlaneGeometry(w, h);

          // Thin frame behind the page so it reads as a mounted document.
          const frame = new THREE.Mesh(
            new THREE.PlaneGeometry(w + 0.07, h + 0.07),
            new THREE.MeshBasicMaterial({ color: 0x171c21, side: THREE.DoubleSide, transparent: true, opacity: 0.95 })
          );
          frame.position.z = -0.006;
          mesh.add(frame);
        },
        undefined,
        () => {
          // Fallback: procedural scanline texture so the slot never looks broken
          const c = document.createElement("canvas");
          c.width = 64;
          c.height = 90;
          const ctx = c.getContext("2d")!;
          ctx.fillStyle = "#14181c";
          ctx.fillRect(0, 0, 64, 90);
          ctx.fillStyle = "#2a3036";
          for (let y = 4; y < 90; y += 4) ctx.fillRect(6, y, 52, 1);
          const tex = new THREE.CanvasTexture(c);
          tex.colorSpace = THREE.SRGBColorSpace;
          mat.map = tex;
          mat.needsUpdate = true;
        }
      );
    };

    const panels: THREE.Mesh[] = [];
    const pendingTextures: Array<() => void> = [];

    pageList.forEach((src, i) => {
      const mat = new THREE.MeshStandardMaterial({
        color: 0x111417,
        roughness: 0.8,
        metalness: 0.02,
        side: THREE.DoubleSide,
        transparent: true,
        opacity: 1,
      });
      const mesh = new THREE.Mesh(new THREE.PlaneGeometry(1, 1), mat);
      const angle = i * step;
      mesh.position.set(Math.sin(angle) * radius, 0, Math.cos(angle) * radius);
      mesh.rotation.y = angle;
      mesh.userData.index = i;
      group.add(mesh);
      panels.push(mesh);

      pendingTextures.push(() => fetchTexture(src, mat, mesh));
    });

    // Flush the deferred texture fetches when the vault gets close.
    const texturePrimer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        texturePrimer.disconnect();
        pendingTextures.forEach((run) => run());
        pendingTextures.length = 0;
      },
      { rootMargin: "1200px 0px" }
    );
    texturePrimer.observe(section);

    // ── Thin orbital rails ───────────────────────────────
    const railMat = new THREE.MeshBasicMaterial({ color: cssColor("--color-line-2", "#2a3036"), transparent: true, opacity: 0.7 });
    [radius + 0.55, radius - 0.55].forEach((r) => {
      const rail = new THREE.Mesh(new THREE.TorusGeometry(r, 0.006, 6, 220), railMat);
      rail.rotation.x = Math.PI / 2;
      group.add(rail);
    });

    // ── Floor disc ───────────────────────────────────────
    const floor = new THREE.Mesh(
      new THREE.CircleGeometry(radius + 1.6, 96),
      new THREE.MeshBasicMaterial({ color: cssColor("--color-ink-2", "#0d0f11"), transparent: true, opacity: 0.55 })
    );
    floor.rotation.x = -Math.PI / 2;
    floor.position.y = -MAX_H / 2 - 0.45;
    scene.add(floor);

    const floorRingMat = new THREE.MeshBasicMaterial({ color: cssColor("--color-signal", "#d4ff3f"), transparent: true, opacity: 0.22 });
    const floorRing = new THREE.Mesh(
      new THREE.RingGeometry(radius + 1.55, radius + 1.62, 128),
      floorRingMat
    );
    floorRing.rotation.x = -Math.PI / 2;
    floorRing.position.y = -MAX_H / 2 - 0.44;
    scene.add(floorRing);

    // Follow theme/accent switches — the stage re-tints in place.
    const retint = () => {
      key.color.copy(cssColor("--color-signal", "#d4ff3f"));
      rim.color.copy(cssColor("--color-cyan", "#34d3e0"));
      railMat.color.copy(cssColor("--color-line-2", "#2a3036"));
      (floor.material as THREE.MeshBasicMaterial).color.copy(cssColor("--color-ink-2", "#0d0f11"));
      floorRingMat.color.copy(cssColor("--color-signal", "#d4ff3f"));
    };
    document.addEventListener("theme:change", retint);
    document.addEventListener("accent:change", retint);

    // ── Interaction state ────────────────────────────────
    let targetRotation = 0;
    let currentRotation = 0;
    let velocity = 0;
    let dragging = false;
    let lastX = 0;
    let scrollBoost = 0;

    const onPointerDown = (e: PointerEvent) => {
      dragging = true;
      lastX = e.clientX;
      canvas.setPointerCapture(e.pointerId);
    };
    const onPointerMove = (e: PointerEvent) => {
      if (!dragging) return;
      const dx = e.clientX - lastX;
      lastX = e.clientX;
      targetRotation += dx * 0.0075;
      velocity = dx * 0.0075;
    };
    const onPointerUp = (e: PointerEvent) => {
      dragging = false;
      if (canvas.hasPointerCapture(e.pointerId)) canvas.releasePointerCapture(e.pointerId);
    };

    canvas.addEventListener("pointerdown", onPointerDown);
    window.addEventListener("pointermove", onPointerMove);
    window.addEventListener("pointerup", onPointerUp);

    // Scroll anywhere in the section advances the ring
    const onWheel = (e: WheelEvent) => {
      const rect = section.getBoundingClientRect();
      if (rect.top > window.innerHeight * 0.8 || rect.bottom < window.innerHeight * 0.2) return;
      scrollBoost += e.deltaY * 0.0009;
    };
    window.addEventListener("wheel", onWheel, { passive: true });

    // ── Sizing ───────────────────────────────────────────
    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      const w = Math.max(rect.width, 1);
      const h = Math.max(rect.height, 1);
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      // Keep the whole ring framed: pull back further on narrow viewports so
      // the near panel doesn't swallow the frame.
      camera.position.z = w < 720 ? 16 : w < 1100 ? 14 : 12.5;
      camera.position.y = w < 720 ? 0.15 : 0.35;
      camera.lookAt(0, w < 720 ? -0.2 : -0.35, 0);
    };
    resize();
    const ro = new ResizeObserver(resize);
    ro.observe(canvas);

    // ── Loop ──────────────────────────────────────────────
    const clock = new THREE.Clock();
    let visible = true;
    const io = new IntersectionObserver(
      ([entry]) => (visible = entry.isIntersecting),
      { threshold: 0.02 }
    );
    io.observe(section);

    const tick = () => {
      requestAnimationFrame(tick);
      const dt = Math.min(clock.getDelta(), 0.05);

      if (!dragging) {
        targetRotation += velocity;
        velocity *= 0.94;
        targetRotation += scrollBoost;
        scrollBoost *= 0.9;
        targetRotation += dt * 0.055; // idle drift
      }

      currentRotation += (targetRotation - currentRotation) * 0.075;
      group.rotation.y = currentRotation;

      // Face the camera-ish and dim only the far side — the near panel stays
      // fully lit, and side panels keep enough presence to read as a ring.
      panels.forEach((panel) => {
        const world = new THREE.Vector3();
        panel.getWorldPosition(world);
        const toCam = camera.position.clone().sub(world).normalize();
        const normal = new THREE.Vector3(0, 0, 1).applyQuaternion(panel.getWorldQuaternion(new THREE.Quaternion()));
        const facing = normal.dot(toCam);
        const mat = panel.material as THREE.MeshStandardMaterial;
        mat.opacity = THREE.MathUtils.clamp(0.42 + 0.58 * (facing * 0.5 + 0.5), 0.42, 1);
      });

      // Counter
      const idx = ((Math.round(-currentRotation / step) % pageList.length) + pageList.length) % pageList.length;
      const label = `${String(idx + 1).padStart(2, "0")} / ${String(pageList.length).padStart(2, "0")}`;
      if (counter.textContent !== label) counter.textContent = label;

      if (visible) renderer.render(scene, camera);
    };
    tick();
  }
</script>

<style>
  #vault-counter {
    font-family: var(--font-mono);
    color: var(--color-chalk);
  }
</style>
