---
import { deployments, checkHealth } from "../data/deployments";
import { rich, td, type T } from "../i18n";

interface Props {
  t: T;
}
const { t } = Astro.props;

const health = await checkHealth();

const rows = deployments.map((d) => ({ ...d, health: health[d.slug] ?? { status: "unknown" as const } }));
const probed = rows.filter((r) => !r.archived);
const live = probed.filter((r) => r.health.status === "live").length;
---

<section id="work" class="relative border-t border-[var(--color-line)]">
  <div class="shell py-24 lg:py-32">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div class="flex flex-col gap-5" data-reveal>
        <span class="eyebrow">{t("sec.deployments.eyebrow")}</span>
        <h2 class="display display-lg" set:html={rich(t("sec.deployments.title"))} />
        <p class="max-w-xl text-[var(--color-fog-2)]">
          {t("sec.deployments.lead")}
        </p>
      </div>
      <div class="flex flex-col items-start gap-2 md:items-end" data-reveal style="--d:120ms">
        <span
          class="font-mono text-[0.6875rem] tracking-[0.2em] text-[var(--color-fog)] uppercase"
          set:html={rich(t("sec.deployments.responding", { live, total: probed.length })) +
            " " +
            rich(t("sec.deployments.archived", { n: rows.length - probed.length }))}
        />
        <span class="font-mono text-[0.5625rem] tracking-[0.16em] text-[var(--color-line-2)] uppercase">{t("sec.deployments.probe")}</span>
      </div>
    </div>

    <!-- Featured deployments -->
    <div class="mt-14 grid gap-px bg-[var(--color-line)] md:grid-cols-2 xl:grid-cols-3">
      {
        rows.map((d, i) => {
          const st = d.health.status;
          return (
            <a
              href={d.url}
              target="_blank"
              rel="noopener"
              class="group relative flex flex-col gap-5 bg-[var(--color-ink)] p-6 no-underline transition-colors hover:bg-[var(--color-ink-2)] lg:p-7"
              data-reveal
              style={`--d:${(i % 3) * 90}ms`}
            >
              <div class="flex items-start justify-between gap-4">
                <span class="font-mono text-[0.625rem] tracking-[0.2em] text-[var(--color-line-2)] uppercase">
                  {String(i + 1).padStart(2, "0")} / {String(rows.length).padStart(2, "0")}
                </span>
                <span class="status" data-state={st}>
                  <span class="status-dot" />
                  {st === "archived" ? t("sec.deployments.archivedStatus") : t(`status.${st}`)}
                  {d.health.ms ? ` · ${d.health.ms}ms` : ""}
                </span>
              </div>

              <div class="flex flex-col gap-2">
                <div class="flex items-center gap-2">
                  <h3 class="font-display text-2xl font-semibold tracking-tight text-[var(--color-chalk)] transition-colors group-hover:text-[var(--color-signal)]">
                    {d.name}
                  </h3>
                  {d.telegram && (
                    <span class="border border-[var(--color-line-2)] px-1.5 py-0.5 font-mono text-[0.5625rem] tracking-[0.14em] text-[var(--color-fog)] uppercase">
                      TG
                    </span>
                  )}
                </div>
                <span class="font-mono text-[0.6875rem] tracking-[0.1em] uppercase" style={{ color: d.accent }}>
                  {td(t, d.tagline)}
                </span>
              </div>

              <p class="text-sm leading-relaxed text-[var(--color-fog-2)]">{td(t, d.description)}</p>

              <div class="mt-auto flex flex-wrap gap-1.5 pt-2">
                {d.stack.map((s) => (
                  <span class="border border-[var(--color-line)] px-2 py-1 font-mono text-[0.5625rem] tracking-[0.1em] text-[var(--color-fog)] uppercase">
                    {s}
                  </span>
                ))}
              </div>

              <div class="flex items-center justify-between border-t border-[var(--color-line)] pt-4">
                <span class="truncate font-mono text-[0.6875rem] text-[var(--color-fog)]">
                  {d.archived ? "github.com/natnael-wubet" : new URL(d.url).host}
                </span>
                <span class="font-mono text-[0.6875rem] tracking-[0.16em] text-[var(--color-fog)] uppercase transition-transform group-hover:translate-x-1 group-hover:text-[var(--color-signal)]">
                  ↗ {d.archived ? t("sec.deployments.source") : d.platform}
                </span>
              </div>

              <span
                class="pointer-events-none absolute inset-x-0 bottom-0 h-px origin-left scale-x-0 transition-transform duration-500 group-hover:scale-x-100"
                style={{ background: d.accent }}
              />
            </a>
          );
        })
      }
    </div>
  </div>
</section>
