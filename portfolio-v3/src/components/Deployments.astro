---
import { deployments, checkHealth } from "../data/deployments";

const health = await checkHealth();

const rows = deployments.map((d) => ({ ...d, health: health[d.slug] ?? { status: "unknown" as const } }));
const probed = rows.filter((r) => !r.archived);
const live = probed.filter((r) => r.health.status === "live").length;
---

<section id="work" class="relative border-t border-[--color-line]">
  <div class="shell py-24 lg:py-32">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div class="flex flex-col gap-5">
        <span class="eyebrow">Section 01 · Deployments</span>
        <h2 class="display display-lg">Shipped &amp;<br />reachable</h2>
        <p class="max-w-xl text-[--color-fog-2]">
          Every URL below was requested while this page was being built. The status you see is a real HTTP response,
          not a claim.
        </p>
      </div>
      <div class="flex flex-col items-start gap-2 md:items-end">
        <span class="font-mono text-[0.6875rem] tracking-[0.2em] text-[--color-fog] uppercase">
          <span class="text-[--color-signal]">{live}</span> / {probed.length} responding
          <span class="text-[--color-line-2]">· {rows.length - probed.length} archived</span>
        </span>
        <span class="font-mono text-[0.5625rem] tracking-[0.16em] text-[--color-line-2] uppercase">Build-time probe</span>
      </div>
    </div>

    <!-- Featured deployments -->
    <div class="mt-14 grid gap-px bg-[--color-line] md:grid-cols-2 xl:grid-cols-3">
      {
        rows.map((d, i) => {
          const st = d.health.status;
          return (
            <a
              href={d.url}
              target="_blank"
              rel="noopener"
              class="group relative flex flex-col gap-5 bg-[--color-ink] p-6 no-underline transition-colors hover:bg-[--color-ink-2] lg:p-7"
            >
              <div class="flex items-start justify-between gap-4">
                <span class="font-mono text-[0.625rem] tracking-[0.2em] text-[--color-line-2] uppercase">
                  {String(i + 1).padStart(2, "0")} / {String(rows.length).padStart(2, "0")}
                </span>
                <span class="status" data-state={st}>
                  <span class="status-dot" />
                  {st === "archived" ? "archived · source" : st}
                  {d.health.ms ? ` · ${d.health.ms}ms` : ""}
                </span>
              </div>

              <div class="flex flex-col gap-2">
                <div class="flex items-center gap-2">
                  <h3 class="font-display text-2xl font-semibold tracking-tight text-[--color-chalk] transition-colors group-hover:text-[--color-signal]">
                    {d.name}
                  </h3>
                  {d.telegram && (
                    <span class="border border-[--color-line-2] px-1.5 py-0.5 font-mono text-[0.5625rem] tracking-[0.14em] text-[--color-fog] uppercase">
                      TG
                    </span>
                  )}
                </div>
                <span class="font-mono text-[0.6875rem] tracking-[0.1em] uppercase" style={{ color: d.accent }}>
                  {d.tagline}
                </span>
              </div>

              <p class="text-sm leading-relaxed text-[--color-fog-2]">{d.description}</p>

              <div class="mt-auto flex flex-wrap gap-1.5 pt-2">
                {d.stack.map((s) => (
                  <span class="border border-[--color-line] px-2 py-1 font-mono text-[0.5625rem] tracking-[0.1em] text-[--color-fog] uppercase">
                    {s}
                  </span>
                ))}
              </div>

              <div class="flex items-center justify-between border-t border-[--color-line] pt-4">
                <span class="truncate font-mono text-[0.6875rem] text-[--color-fog]">
                  {d.archived ? "github.com/natnael-wubet" : new URL(d.url).host}
                </span>
                <span class="font-mono text-[0.6875rem] tracking-[0.16em] text-[--color-fog] uppercase transition-transform group-hover:translate-x-1 group-hover:text-[--color-signal]">
                  ↗ {d.archived ? "Source" : d.platform}
                </span>
              </div>

              <span
                class="pointer-events-none absolute inset-x-0 bottom-0 h-px origin-left scale-x-0 transition-transform duration-500 group-hover:scale-x-100"
                style={{ background: d.accent }}
              />
            </a>
          );
        })
      }
    </div>
  </div>
</section>
