---
import { existsSync } from "node:fs";
import { deployments, checkHealth } from "../data/deployments";
import { rich, td, type T } from "../i18n";
import ProjectDialog, { type ProjectRecord } from "./ProjectDialog.astro";
import ProjectLogo from "./ProjectLogo.astro";

interface Props {
  t: T;
}
const { t } = Astro.props;

const health = await checkHealth();

const devices = ["desktop", "tablet", "phone"] as const;
const hasShot = (slug: string, device: (typeof devices)[number]) =>
  existsSync(`public/shots/${slug}-${device}.webp`);

const rows = deployments.map((d) => {
  const shots = {
    desktop: hasShot(d.slug, "desktop"),
    tablet: hasShot(d.slug, "tablet"),
    phone: hasShot(d.slug, "phone"),
  };
  return {
    ...d,
    health: health[d.slug] ?? { status: "unknown" as const },
    shots,
    captures: Object.values(shots).filter(Boolean).length,
    host: new URL(d.url).host,
  };
});
const probed = rows.filter((r) => !r.archived);
const live = probed.filter((r) => r.health.status === "live").length;

const categories = ["Product", "Platform", "Tool", "Game", "Protocol"] as const;
const counts = Object.fromEntries(
  categories.map((category) => [category, rows.filter((r) => r.category === category).length])
) as Record<(typeof categories)[number], number>;

const projects: ProjectRecord[] = rows.map((d) => ({
  slug: d.slug,
  name: d.name,
  tagline: td(t, d.tagline),
  description: td(t, d.description),
  url: d.url,
  platform: d.platform,
  year: d.year ?? null,
  stack: d.stack,
  category: td(t, d.category),
  accent: d.accent,
  archived: Boolean(d.archived),
  status: d.health.status,
  statusLabel: d.archived ? t("sec.deployments.archivedStatus") : t(`status.${d.health.status}`),
  ms: d.health.ms ?? null,
  host: d.host,
  shots: d.shots,
}));
---

<section id="work" class="relative border-t border-[var(--color-line)]">
  <div class="shell py-24 lg:py-32">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div class="flex flex-col gap-5" data-reveal>
        <span class="eyebrow">{t("sec.deployments.eyebrow")}</span>
        <h2 class="display display-lg" set:html={rich(t("sec.deployments.title"))} />
        <p class="max-w-xl text-[var(--color-fog-2)]">
          {t("sec.deployments.lead")}
        </p>
      </div>
      <div class="flex flex-col items-start gap-2 md:items-end" data-reveal style="--d:120ms">
        <span
          class="font-mono text-[0.6875rem] tracking-[0.2em] text-[var(--color-fog)] uppercase"
          set:html={rich(t("sec.deployments.responding", { live, total: probed.length })) +
            " " +
            rich(t("sec.deployments.archived", { n: rows.length - probed.length }))}
        />
        <span class="font-mono text-[0.5625rem] tracking-[0.16em] text-[var(--color-line-2)] uppercase">{t("sec.deployments.probe")}</span>
      </div>
    </div>

    <!-- Category filter: the grid is long, so let people cut it down. -->
    <div class="deploy-tools" data-reveal style="--d:180ms">
      <div class="deploy-filter-wrap">
        <span class="deploy-tools-label" id="deploy-filter-label">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true">
            <path d="M2 3.5h12L9.5 8.5v4l-3 1.5v-5.5z" />
          </svg>
          {t("sec.deployments.filters.title")}
        </span>
        <div class="deploy-filters" role="group" aria-labelledby="deploy-filter-label">
          <button class="deploy-chip" type="button" data-filter="all" aria-pressed="true">
            {t("sec.deployments.filters.all")}
            <span class="deploy-chip-count">{rows.length}</span>
          </button>
          {
            categories.map((category) => (
              <button class="deploy-chip" type="button" data-filter={category} aria-pressed="false">
                {td(t, category)}
                <span class="deploy-chip-count">{counts[category]}</span>
              </button>
            ))
          }
        </div>
      </div>
      <span
        class="deploy-showing"
        data-showing
        data-template={t("sec.deployments.filters.showing")}
        aria-live="polite"
      >
        {t("sec.deployments.filters.showing", { n: rows.length, total: rows.length })}
      </span>
    </div>

    <!-- Deployment cards: logo first, dossier on open. -->
    <div class="deploy-grid">
      {
        rows.map((d, i) => {
          const st = d.health.status;
          return (
            <article
              class="deploy-card group relative flex flex-col bg-[var(--color-ink)]"
              data-reveal
              data-category={d.category}
              style={`--d:${(i % 3) * 90}ms;--deploy-accent:${d.accent}`}
            >
              <div class="deploy-media">
                <span class="deploy-plate" aria-hidden="true">
                  <span class="deploy-plate-grid" />
                  <span class="deploy-plate-aura" />
                </span>

                <span class="deploy-media-bar">
                  <span class="deploy-index">
                    {String(i + 1).padStart(2, "0")} / {String(rows.length).padStart(2, "0")}
                  </span>
                  <span class="status" data-state={st}>
                    <span class="status-dot" />
                    {st === "archived" ? t("sec.deployments.archivedStatus") : t(`status.${st}`)}
                    {d.health.ms ? ` · ${d.health.ms}ms` : ""}
                  </span>
                </span>

                <span class="deploy-logo-wrap">
                  <ProjectLogo slug={d.slug} accent={d.accent} />
                </span>

                <span class="deploy-media-foot">
                  <span class="deploy-kind">{td(t, d.category)}</span>
                  <span class="deploy-open-pill">
                    {t("sec.deployments.inspect")}
                    <span class="deploy-open-arrow" aria-hidden="true">↗</span>
                  </span>
                </span>

                <span class="deploy-spot" aria-hidden="true" />
                <span class="deploy-scan" aria-hidden="true" />
              </div>

              <div class="deploy-body">
                <div class="flex items-center gap-2">
                  <h3
                    id={`${d.slug}-name`}
                    class="font-display text-2xl font-semibold tracking-tight text-[var(--color-chalk)] transition-colors group-hover:text-[var(--color-signal)]"
                  >
                    {d.name}
                  </h3>
                  {d.telegram && (
                    <span class="border border-[var(--color-line-2)] px-1.5 py-0.5 font-mono text-[0.5625rem] tracking-[0.14em] text-[var(--color-fog)] uppercase">
                      TG
                    </span>
                  )}
                </div>
                <span class="deploy-tagline font-mono text-[0.6875rem] tracking-[0.1em] uppercase">
                  {td(t, d.tagline)}
                </span>

                <p class="deploy-desc text-sm leading-relaxed text-[var(--color-fog-2)]">{td(t, d.description)}</p>

                <div class="mt-auto flex flex-wrap gap-1.5 pt-2">
                  {d.stack.slice(0, 5).map((s) => (
                    <span class="border border-[var(--color-line)] px-2 py-1 font-mono text-[0.5625rem] tracking-[0.1em] text-[var(--color-fog)] uppercase">
                      {s}
                    </span>
                  ))}
                </div>

                <div class="deploy-foot">
                  <span class="truncate font-mono text-[0.6875rem] text-[var(--color-fog)]">{d.host}</span>
                  {d.captures > 0 ? (
                    <span class="deploy-captures">
                      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
                        <rect x="1.6" y="4.4" width="12.8" height="9.4" rx="1.6" />
                        <path d="M5.2 4.4 6.1 2.6h3.8l.9 1.8" />
                        <circle cx="8" cy="9" r="2.5" />
                      </svg>
                      {t("sec.deployments.captures", { n: d.captures })}
                    </span>
                  ) : d.archived ? (
                    <span class="deploy-captures">
                      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true">
                        <path d="M6 3.5 3.5 6 6 8.5M10 3.5 12.5 6 10 8.5M3.5 6h9" />
                        <path d="M3.5 12.5h9" />
                      </svg>
                      {t("sec.deployments.source")}
                    </span>
                  ) : null}
                </div>
              </div>

              <button
                class="deploy-hit"
                type="button"
                data-project={d.slug}
                aria-haspopup="dialog"
                aria-label={`${d.name}: ${t("sec.deployments.inspect")}`}
              />

              <span
                class="pointer-events-none absolute inset-x-0 bottom-0 z-[3] h-px origin-left scale-x-0 transition-transform duration-500 group-hover:scale-x-100"
                style={{ background: "var(--deploy-accent)" }}
              />
            </article>
          );
        })
      }
    </div>
  </div>

  <ProjectDialog t={t} projects={projects} />
</section>

<script>
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>(".deploy-chip"));
  const cards = Array.from(document.querySelectorAll<HTMLElement>(".deploy-card"));
  const grid = document.querySelector<HTMLElement>(".deploy-grid");
  const showing = document.querySelector<HTMLElement>("[data-showing]");
  const template = showing?.dataset.template ?? "{n} / {total}";
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)").matches;

  // ── Filtering ──────────────────────────────────────────────
  //    The cards are already in the DOM; filtering only toggles `hidden`, so
  //    nothing is fetched or rebuilt. The visible slugs are announced so the
  //    dossier pages through the same set the reader is looking at.
  const setFilter = (value: string) => {
    const visibleSlugs: string[] = [];
    cards.forEach((card) => {
      const match = value === "all" || card.dataset.category === value;
      card.hidden = !match;
      if (match) {
        card.classList.add("is-in");
        const slug = card.querySelector<HTMLElement>("[data-project]")?.dataset.project;
        if (slug) visibleSlugs.push(slug);
      }
    });
    chips.forEach((chip) => {
      chip.setAttribute("aria-pressed", String(chip.dataset.filter === value));
    });
    grid?.classList.toggle("is-filtered", value !== "all");
    if (showing) {
      showing.textContent = template
        .replace("{n}", String(visibleSlugs.length))
        .replace("{total}", String(cards.length));
    }
    document.dispatchEvent(
      new CustomEvent("deploy:filter", { detail: { slugs: visibleSlugs } })
    );
  };

  chips.forEach((chip) => {
    chip.addEventListener("click", () => setFilter(chip.dataset.filter ?? "all"));
  });

  // ── Pointer spotlight ──────────────────────────────────────
  //    A cursor-following glow makes the card feel like a lit surface rather
  //    than a picture. Touch and reduced-motion readers get the static plate.
  if (finePointer && !reduced) {
    cards.forEach((card) => {
      card.addEventListener("pointermove", (event) => {
        const box = card.getBoundingClientRect();
        card.style.setProperty("--mx", `${event.clientX - box.left}px`);
        card.style.setProperty("--my", `${event.clientY - box.top}px`);
      });
    });
  }
</script>

<style>
  .deploy-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1px;
    margin-top: 1.5rem;
    background: var(--color-line);
    border: 1px solid var(--color-line);
  }

  @media (min-width: 700px) {
    .deploy-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1180px) {
    .deploy-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .deploy-card {
    transition: background-color 0.22s ease;
  }

  .deploy-card[hidden] {
    display: none;
  }

  /*
   * A filtered grid can leave an empty cell at the end. Dropping the shared
   * hairline background and outlining each visible card keeps that leftover
   * space from reading as a missing project.
   */
  .deploy-grid.is-filtered {
    background: transparent;
    border-color: transparent;
  }

  .deploy-grid.is-filtered .deploy-card {
    box-shadow: 0 0 0 1px var(--color-line);
  }

  .deploy-card:has(.deploy-hit:hover) {
    background: var(--color-ink-2);
  }

  .deploy-card:has(.deploy-hit:focus-visible) {
    outline: 2px solid var(--color-signal);
    outline-offset: -2px;
  }

  /* ── Filter bar ─────────────────────────────────────────── */
  .deploy-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem 1.25rem;
    margin-top: 2.75rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-line);
  }

  .deploy-filter-wrap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .deploy-tools-label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-fog);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .deploy-tools-label svg {
    width: 12px;
    height: 12px;
  }

  .deploy-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .deploy-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.42rem 0.65rem;
    border: 1px solid var(--color-line);
    background: transparent;
    color: var(--color-fog-2);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
  }

  .deploy-chip:hover {
    border-color: var(--color-line-2);
    color: var(--color-chalk);
  }

  .deploy-chip:focus-visible {
    outline: 1px solid var(--color-signal);
    outline-offset: 2px;
  }

  .deploy-chip[aria-pressed="true"] {
    border-color: var(--color-signal);
    background: color-mix(in srgb, var(--color-signal) 10%, transparent);
    color: var(--color-chalk);
  }

  .deploy-chip-count {
    color: var(--color-fog);
    font-size: 0.5rem;
    letter-spacing: 0.06em;
  }

  .deploy-chip[aria-pressed="true"] .deploy-chip-count {
    color: var(--color-signal);
  }

  .deploy-showing {
    color: var(--color-fog);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* ── Logo plate ─────────────────────────────────────────── */
  .deploy-media {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    aspect-ratio: 16 / 9;
    border-bottom: 1px solid var(--color-line);
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--deploy-accent) 8%, transparent), transparent 45%),
      var(--color-ink-2);
  }

  .deploy-plate,
  .deploy-spot,
  .deploy-scan {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .deploy-plate-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(color-mix(in srgb, var(--color-line) 72%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--color-line) 72%, transparent) 1px, transparent 1px);
    background-size: 26px 26px;
    opacity: 0.55;
    mask-image: radial-gradient(82% 82% at 50% 46%, #000 20%, transparent 78%);
  }

  .deploy-plate-aura {
    position: absolute;
    top: 46%;
    left: 50%;
    width: 64%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--deploy-accent) 30%, transparent), transparent 68%);
    filter: blur(8px);
    opacity: 0.72;
    transform: translate(-50%, -50%);
    transition: opacity 0.4s ease, transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .deploy-logo-wrap {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 2.3rem 1.25rem 2.9rem;
    filter: drop-shadow(0 12px 26px color-mix(in srgb, var(--deploy-accent) 20%, transparent));
    transition: transform 0.55s cubic-bezier(0.16, 1, 0.3, 1), filter 0.35s ease;
  }

  .deploy-media-bar {
    position: absolute;
    inset: 0 0 auto;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.6rem 0.7rem;
  }

  .deploy-index {
    padding: 0.18rem 0.35rem;
    background: color-mix(in srgb, var(--color-ink) 68%, transparent);
    color: var(--color-fog-2);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.16em;
    backdrop-filter: blur(4px);
  }

  .deploy-media-bar .status {
    padding: 0.18rem 0.4rem;
    background: color-mix(in srgb, var(--color-ink) 68%, transparent);
    color: var(--color-fog-2);
    font-size: 0.5625rem;
    backdrop-filter: blur(4px);
  }

  .deploy-media-foot {
    position: absolute;
    inset: auto 0.7rem 0.65rem;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .deploy-kind {
    padding: 0.22rem 0.4rem;
    border: 1px solid color-mix(in srgb, var(--deploy-accent) 32%, var(--color-line-2));
    background: color-mix(in srgb, var(--color-ink) 68%, transparent);
    color: var(--color-fog-2);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    backdrop-filter: blur(4px);
  }

  .deploy-open-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.38rem 0.6rem;
    border: 1px solid color-mix(in srgb, var(--deploy-accent) 52%, var(--color-line-2));
    background: color-mix(in srgb, var(--deploy-accent) 12%, color-mix(in srgb, var(--color-ink) 78%, transparent));
    color: var(--color-chalk);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    white-space: nowrap;
    backdrop-filter: blur(6px);
    transition: background-color 0.22s ease, border-color 0.22s ease, transform 0.22s ease;
  }

  .deploy-open-arrow {
    color: var(--deploy-accent);
    transition: transform 0.22s ease;
  }

  .deploy-card:has(.deploy-hit:hover) .deploy-open-pill,
  .deploy-card:has(.deploy-hit:focus-visible) .deploy-open-pill {
    border-color: var(--deploy-accent);
    background: color-mix(in srgb, var(--deploy-accent) 30%, var(--color-ink));
    transform: translateY(-1px);
  }

  .deploy-card:has(.deploy-hit:hover) .deploy-open-arrow {
    transform: translate(1px, -1px);
  }

  .deploy-card:has(.deploy-hit:hover) .deploy-plate-aura {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1.12);
  }

  .deploy-card:has(.deploy-hit:hover) .deploy-logo-wrap {
    transform: translateY(-4px) scale(1.04);
    filter: drop-shadow(0 16px 32px color-mix(in srgb, var(--deploy-accent) 32%, transparent));
  }

  .deploy-spot {
    z-index: 1;
    background: radial-gradient(
      220px circle at var(--mx, 50%) var(--my, 42%),
      color-mix(in srgb, var(--deploy-accent) 22%, transparent),
      transparent 70%
    );
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .deploy-card:has(.deploy-hit:hover) .deploy-spot {
    opacity: 1;
  }

  .deploy-scan {
    z-index: 1;
    top: 0;
    bottom: auto;
    height: 1px;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--deploy-accent) 85%, white), transparent);
    opacity: 0;
  }

  .deploy-card:has(.deploy-hit:hover) .deploy-scan {
    animation: deploy-scan 1.7s cubic-bezier(0.4, 0, 0.2, 1);
  }

  @keyframes deploy-scan {
    0% {
      top: 0;
      opacity: 0;
    }
    18% {
      opacity: 0.75;
    }
    100% {
      top: 100%;
      opacity: 0;
    }
  }

  /* ── Card body ──────────────────────────────────────────── */
  .deploy-body {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    flex: 1;
    padding: 1.25rem;
  }

  @media (min-width: 1180px) {
    .deploy-body {
      padding: 1.5rem;
    }
  }

  .deploy-desc {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
  }

  /*
   * Each card's accent comes from the data. Mixing it toward --color-chalk
   * keeps the tagline readable in both themes without a second palette:
   * chalk is near-white on dark and near-black on light.
   */
  .deploy-tagline {
    color: color-mix(in srgb, var(--deploy-accent) 72%, var(--color-chalk));
  }

  .deploy-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    border-top: 1px solid var(--color-line);
    padding-top: 0.9rem;
  }

  .deploy-captures {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-fog);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .deploy-captures svg {
    width: 11px;
    height: 11px;
  }

  /* The whole card is the hit area, but the content stays a normal article. */
  .deploy-hit {
    position: absolute;
    inset: 0;
    z-index: 3;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .deploy-hit:focus-visible {
    outline: none;
  }

  @media (max-width: 640px) {
    .deploy-tools {
      align-items: flex-start;
    }

    .deploy-filter-wrap {
      width: 100%;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.55rem;
    }

    .deploy-filters {
      width: 100%;
      flex-wrap: nowrap;
      overflow-x: auto;
      padding-bottom: 0.3rem;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    .deploy-filters::-webkit-scrollbar {
      display: none;
    }

    .deploy-chip {
      flex: 0 0 auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
