---
import { deployments } from "../data/deployments";
import { repos, socials, awards, certifications, disciplines } from "../data/content";
import { locales, td, type Lang, type T } from "../i18n";

interface Props {
  t: T;
  lang: Lang;
}
const { t, lang } = Astro.props;

interface PaletteItem {
  label: string;
  meta: string;
  href: string;
  kind: string;
  keywords: string;
}

// Kinds are translated at build time — the payload is JSON, so the client
// only ever renders strings that already match the page's language.
const KIND = {
  deploy: t("palette.kind.Deploy"),
  repo: t("palette.kind.Repo"),
  award: t("palette.kind.Award"),
  cert: t("palette.kind.Cert"),
  link: t("palette.kind.Link"),
  doc: t("palette.kind.Doc"),
  play: t("palette.kind.Play"),
  mind: t("palette.kind.Mind"),
  jump: t("palette.kind.Jump"),
  option: t("palette.kind.Option"),
  match: t("palette.kind.Match"),
};

const items: PaletteItem[] = [
  ...deployments.map((d) => ({
    label: d.name,
    meta: `${d.platform} · ${td(t, d.tagline)}`,
    href: d.url,
    kind: KIND.deploy,
    keywords: `${d.name} ${d.tagline} ${td(t, d.tagline)} ${d.description} ${td(t, d.description)} ${d.stack.join(" ")} ${d.category}`,
  })),
  ...repos.map((r) => ({
    label: r.name,
    meta: `${t(`sec.repos.group.${r.group}`)} · ${td(t, r.description)}`,
    href: r.url,
    kind: KIND.repo,
    keywords: `${r.name} ${r.description} ${td(t, r.description)} ${r.language} ${r.group}`,
  })),
  ...awards.map((a) => ({
    label: a.title,
    meta: `${td(t, a.rank)} · ${a.org}`,
    href: "#awards",
    kind: KIND.award,
    keywords: `${a.title} ${a.org} ${a.detail} ${td(t, a.detail)} ${a.prize ?? ""} ${td(t, a.prize ?? "")} ${a.rank}`,
  })),
  ...certifications.map((c) => ({
    label: c.name,
    meta: c.issuer,
    href: c.file,
    kind: KIND.cert,
    keywords: `${c.name} ${c.issuer} ${c.detail}`,
  })),
  ...socials.map((s) => ({
    label: td(t, s.label),
    meta: s.handle,
    href: s.href,
    kind: KIND.link,
    keywords: `${s.label} ${td(t, s.label)} ${s.handle}`,
  })),
  { label: t("palette.cv"), meta: t("palette.cvMeta"), href: "/assets/cv.pdf", kind: KIND.doc, keywords: "cv resume curriculum vitae pdf download ሲቪ" },
  { label: t("palette.github"), meta: "@natnael-wubet", href: "https://github.com/natnael-wubet", kind: KIND.link, keywords: "github profile all repositories" },
  { label: t("palette.telegram"), meta: "@nnaty_w20", href: "https://t.me/nnaty_w20", kind: KIND.link, keywords: "telegram contact chat ቴሌግራም" },
  { label: t("palette.bigxo"), meta: t("palette.bigxoMeta"), href: "https://t.me/bigxoGameBot", kind: KIND.play, keywords: "bigxo game telegram mini app play xo" },
  // The interior — so "physics" or "hegel" lands somewhere real.
  ...disciplines.map((d) => ({
    label: td(t, d.name),
    meta: `${t("palette.interior")} · ${d.tags.slice(0, 3).map((tag) => td(t, tag)).join(" · ")}`,
    href: "#mind",
    kind: KIND.mind,
    keywords: `${d.name} ${td(t, d.name)} ${d.blurb} ${td(t, d.blurb)} ${d.tags.join(" ")} ${d.tags.map((tag) => td(t, tag)).join(" ")}`,
  })),
  // ── Display options — real actions, dispatched as events ──
  { label: t("palette.opt.toggleTheme"), meta: t("palette.opt.toggleThemeMeta"), href: "action:theme:toggle", kind: KIND.option, keywords: "theme dark light mode appearance toggle contrast" },
  { label: t("palette.opt.darkTheme"), meta: t("palette.opt.darkThemeMeta"), href: "action:theme:dark", kind: KIND.option, keywords: "theme dark night mode appearance" },
  { label: t("palette.opt.lightTheme"), meta: t("palette.opt.lightThemeMeta"), href: "action:theme:light", kind: KIND.option, keywords: "theme light day mode appearance" },
  { label: t("palette.opt.systemTheme"), meta: t("palette.opt.systemThemeMeta"), href: "action:theme:system", kind: KIND.option, keywords: "theme system auto os appearance" },
  ...(["lime", "cyan", "amber", "rose", "violet"] as const).map((a) => ({
    label: t("palette.opt.accent", { name: a }),
    meta: t("palette.opt.accentMeta"),
    href: `action:accent:${a}`,
    kind: KIND.option,
    keywords: `accent colour ${a} signal`,
  })),
  { label: t("palette.opt.shortcuts"), meta: t("palette.opt.shortcutsMeta"), href: "action:help", kind: KIND.option, keywords: "keyboard shortcuts help keys commands" },
  { label: t("palette.opt.share"), meta: t("palette.opt.shareMeta"), href: "action:share", kind: KIND.option, keywords: "share link url copy view theme accent section" },
  { label: t("palette.opt.diag"), meta: t("palette.opt.diagMeta"), href: "action:diag", kind: KIND.option, keywords: "diagnostics stats performance telemetry measure fps memory network build" },
  { label: t("palette.opt.xray"), meta: t("palette.opt.xrayMeta"), href: "action:xray", kind: KIND.option, keywords: "xray x-ray inspect outline grid tokens colours layout debug" },
  { label: t("palette.opt.brief"), meta: t("palette.opt.briefMeta"), href: "action:brief", kind: KIND.option, keywords: "brief tailored lens hire team product games security protocols founding download markdown cv resume" },
  { label: t("palette.opt.fit"), meta: t("palette.opt.fitMeta"), href: "action:fit", kind: KIND.option, keywords: "fit check role job description match coverage gaps skills hiring paste local" },
  { label: t("palette.opt.profile"), meta: t("palette.opt.profileMeta"), href: "action:profile", kind: KIND.option, keywords: "machine profile json copy agent llm export api structured data" },
  { label: t("palette.opt.llms"), meta: t("palette.opt.llmsMeta"), href: "/llms.txt", kind: KIND.doc, keywords: "llms txt agent ai index crawler machine readable" },
  // Language is a navigation, not a state toggle: both locales are static.
  {
    label: lang === "en" ? t("palette.opt.langAm") : t("palette.opt.langEn"),
    meta: lang === "en" ? t("palette.opt.langAmMeta") : t("palette.opt.langEnMeta"),
    href: `action:lang:${locales[lang].alternate}`,
    kind: KIND.option,
    keywords: "language amharic english አማርኛ switch locale ቋንቋ",
  },
  // Section jumps.
  { label: t("palette.jump.work"), meta: t("palette.jump.workMeta"), href: "#work", kind: KIND.jump, keywords: "deployments projects live work shipped urls" },
  { label: t("palette.jump.origin"), meta: t("palette.jump.originMeta"), href: "#origin", kind: KIND.jump, keywords: "origin story history timeline 2014 bahir dar heritage" },
  { label: t("palette.jump.vault"), meta: t("palette.jump.vaultMeta"), href: "#vault", kind: KIND.jump, keywords: "cv vault resume three dimensional carousel" },
  { label: t("palette.jump.awards"), meta: t("palette.jump.awardsMeta"), href: "#awards", kind: KIND.jump, keywords: "awards record competitions certifications ccna" },
  { label: t("palette.jump.photos"), meta: t("palette.jump.photosMeta"), href: "#photos", kind: KIND.jump, keywords: "photos personal pictures selfies off-screen" },
  { label: t("palette.jump.contact"), meta: t("palette.jump.contactMeta"), href: "#connect", kind: KIND.jump, keywords: "contact email phone telegram hire reach" },
  { label: t("palette.jump.machine"), meta: t("palette.jump.machineMeta"), href: "#machine", kind: KIND.jump, keywords: "machine readable json profile llms resume markdown agent api structured data" },
];
---

<div class="palette-backdrop" id="palette" role="dialog" aria-modal="true" aria-label={t("palette.aria")} data-toast-copied={t("ui.linkCopied")} data-toast-profile={t("machine.copied")}>
  <div class="palette">
    <input
      class="palette-input"
      id="palette-input"
      type="text"
      placeholder={t("palette.placeholder")}
      autocomplete="off"
      spellcheck="false"
      aria-controls="palette-list"
    />
    <div
      class="palette-list"
      id="palette-list"
      role="listbox"
      data-empty={t("palette.empty")}
      data-kind-match={KIND.match}
    ></div>
  </div>
</div>

<!-- Payload rides as JSON so the script below can stay a real module. -->
<script type="application/json" id="palette-data" set:html={JSON.stringify(items)} />

<script>
  type Item = {
    label: string;
    meta: string;
    href: string;
    kind: string;
    keywords: string;
    /** Full-text results carry the prose they matched and the element to reveal. */
    snippet?: string;
    target?: HTMLElement;
    tokens?: string[];
  };

  type Chunk = { text: string; href: string; target: HTMLElement };

  const payload = document.getElementById("palette-data")?.textContent ?? "[]";
  const data = JSON.parse(payload) as Item[];
  const backdrop = document.getElementById("palette") as HTMLDivElement;
  const input = document.getElementById("palette-input") as HTMLInputElement;
  const list = document.getElementById("palette-list") as HTMLDivElement;
  // Frontmatter values cannot be referenced from a client module; the label
  // for prose hits rides on the list as data instead.
  const MATCH_KIND = list.dataset.kindMatch ?? "Match";

  let active = 0;
  let visible: Item[] = [];
  let index: Chunk[] | null = null;

  // Tight fuzzy match: consecutive matched characters may not be more than a
  // few apart. This runs against the label only — the keyword blob contains
  // whole project descriptions, where a loose subsequence matches anything
  // (searching "physics" used to return unrelated deployments).
  function fuzzy(hay: string, needle: string, maxGap = 4): boolean {
    if (needle.length < 3) return false;
    for (let start = 0; start < hay.length; start++) {
      if (hay[start] !== needle[0]) continue;
      let i = 1;
      let prev = start;
      for (let j = start + 1; j < hay.length && i < needle.length; j++) {
        if (hay[j] !== needle[i]) continue;
        if (j - prev - 1 > maxGap) break;
        prev = j;
        i++;
      }
      if (i === needle.length) return true;
    }
    return false;
  }

  function score(item: Item, q: string): number {
    const hay = item.keywords.toLowerCase();
    const label = item.label.toLowerCase();
    if (label === q) return 100;
    if (label.startsWith(q)) return 80;
    if (label.includes(q)) return 60;
    if (hay.includes(q)) return 30;
    // Multi-word query: every word has to appear somewhere in the blob.
    const words = q.split(/\s+/).filter(Boolean);
    if (words.length > 1 && words.every((w) => hay.includes(w))) return 25;
    if (fuzzy(label, q)) return 12;
    return 0;
  }

  /**
   * The page searches itself. Rather than shipping a second content index,
   * the palette walks the rendered sections once (on first prose search) and
   * splits them into sentence-sized chunks. That means the index is exactly
   * what the visitor can see, in whichever language the page was built.
   */
  function buildIndex(): Chunk[] {
    if (index) return index;
    const chunks: Chunk[] = [];
    const sections = document.querySelectorAll<HTMLElement>("main > section[id]");
    sections.forEach((section) => {
      const href = `#${section.id}`;
      section.querySelectorAll<HTMLElement>("h1, h2, h3, p, li, blockquote").forEach((el) => {
        const text = (el.textContent ?? "").replace(/\s+/g, " ").trim();
        if (text.length < 24) return;
        // Long prose becomes one chunk per sentence so the excerpt can land
        // on the phrase, not on the whole paragraph.
        const parts =
          text.length > 200 ? (text.match(/[^.!?።]+[.!?።]+/g) ?? [text]) : [text];
        parts.forEach((part) => {
          const clean = part.trim();
          if (clean.length >= 24) chunks.push({ text: clean, href, target: el });
        });
      });
    });
    index = chunks;
    return chunks;
  }

  /** Excerpt around the earliest match, so results read like search hits. */
  function excerpt(text: string, tokens: string[], max = 108): string {
    const lower = text.toLowerCase();
    let at = -1;
    for (const token of tokens) {
      const i = lower.indexOf(token);
      if (i >= 0 && (at < 0 || i < at)) at = i;
    }
    if (text.length <= max) return text;
    const start = at < 0 ? 0 : Math.max(0, at - 32);
    const end = Math.min(text.length, start + max);
    return `${start > 0 ? "… " : ""}${text.slice(start, end).trim()}${end < text.length ? " …" : ""}`;
  }

  /** Full-text matches: every token must appear in the same chunk. */
  function searchPage(q: string): Item[] {
    const tokens = q.split(/\s+/).filter((w) => w.length >= 2);
    if (!tokens.length) return [];

    const scored: { chunk: Chunk; s: number }[] = [];
    for (const chunk of buildIndex()) {
      const hay = chunk.text.toLowerCase();
      let s = 0;
      let all = true;
      for (const token of tokens) {
        const at = hay.indexOf(token);
        if (at === -1) {
          all = false;
          break;
        }
        // Earlier matches and shorter chunks are more specific.
        s += 10 + Math.max(0, 8 - Math.floor(at / 30));
      }
      if (!all) continue;
      s += Math.max(0, 20 - Math.floor(chunk.text.length / 20));
      scored.push({ chunk, s });
    }

    scored.sort((a, b) => b.s - a.s);

    const seen = new Set<string>();
    const out: Item[] = [];
    for (const { chunk } of scored) {
      const key = chunk.text.slice(0, 80);
      if (seen.has(key)) continue;
      seen.add(key);
      out.push({
        label: excerpt(chunk.text, tokens),
        meta: chunk.href.replace("#", "§ "),
        href: chunk.href,
        kind: MATCH_KIND,
        keywords: "",
        snippet: excerpt(chunk.text, tokens),
        target: chunk.target,
        tokens,
      });
      if (out.length >= 6) break;
    }
    return out;
  }

  /** Paint one string with <mark> around every token, without innerHTML. */
  function marked(text: string, tokens: string[]): HTMLElement {
    const lower = text.toLowerCase();
    const spans: [number, number][] = [];
    for (const token of tokens) {
      let from = 0;
      while (from < lower.length) {
        const at = lower.indexOf(token, from);
        if (at === -1) break;
        spans.push([at, at + token.length]);
        from = at + token.length;
      }
    }
    spans.sort((a, b) => a[0] - b[0]);

    const merged: [number, number][] = [];
    for (const span of spans) {
      const last = merged[merged.length - 1];
      if (last && span[0] <= last[1]) last[1] = Math.max(last[1], span[1]);
      else merged.push([...span]);
    }

    const wrap = document.createElement("span");
    let pos = 0;
    for (const [start, end] of merged) {
      if (start > pos) wrap.append(document.createTextNode(text.slice(pos, start)));
      const mark = document.createElement("mark");
      mark.textContent = text.slice(start, end);
      wrap.append(mark);
      pos = end;
    }
    if (pos < text.length) wrap.append(document.createTextNode(text.slice(pos)));
    return wrap;
  }

  /**
   * Reveal a prose hit: scroll the block into view and, where the browser
   * supports the Custom Highlight API, tint every occurrence in place. The
   * highlight fades on its own; nothing is mutated in the document.
   */
  function reveal(target: HTMLElement, tokens: string[]) {
    target.scrollIntoView({ behavior: "smooth", block: "center" });

    const api = CSS as unknown as { highlights?: Map<string, unknown> };
    const HighlightCtor = (window as unknown as { Highlight?: new (...r: Range[]) => unknown }).Highlight;
    if (!api.highlights || !HighlightCtor) return;

    api.highlights.delete("palette-search");
    const ranges: Range[] = [];
    const walker = document.createTreeWalker(target, NodeFilter.SHOW_TEXT);
    while (walker.nextNode()) {
      const node = walker.currentNode as Text;
      const value = node.nodeValue ?? "";
      const lower = value.toLowerCase();
      for (const token of tokens) {
        let from = 0;
        while (from < lower.length) {
          const at = lower.indexOf(token, from);
          if (at === -1) break;
          const range = new Range();
          range.setStart(node, at);
          range.setEnd(node, at + token.length);
          ranges.push(range);
          from = at + token.length;
        }
      }
    }

    if (ranges.length) {
      api.highlights.set("palette-search", new HighlightCtor(...ranges));
      window.setTimeout(() => api.highlights?.delete("palette-search"), 4200);
    }
  }

  function render(query: string) {
    const q = query.trim().toLowerCase();
    const base = q
      ? data
          .map((item) => ({ item, s: score(item, q) }))
          .filter((x) => x.s > 0)
          .sort((a, b) => b.s - a.s)
          .slice(0, 30)
          .map((x) => x.item)
      : data.slice(0, 24);

    // Prose search costs one DOM walk, so it waits for a real query.
    const prose = q.length >= 3 ? searchPage(q) : [];
    visible = [...base, ...prose];

    active = 0;
    list.innerHTML = "";

    if (visible.length === 0) {
      list.innerHTML = "";
      const note = document.createElement("div");
      note.className = "palette-empty";
      note.textContent = list.dataset.empty ?? "";
      list.appendChild(note);
      return;
    }

    const tokens = q.split(/\s+/).filter(Boolean);

    visible.forEach((item, i) => {
      const btn = document.createElement("button");
      btn.className = "palette-item";
      btn.type = "button";
      btn.dataset.active = String(i === 0);
      btn.setAttribute("role", "option");
      if (item.snippet) btn.dataset.snippet = "true";

      const kind = document.createElement("span");
      kind.className = "palette-item-kind";
      kind.textContent = item.kind;
      const name = document.createElement("span");
      name.className = "palette-item-name";
      if (item.snippet) name.append(marked(item.snippet, tokens));
      else name.textContent = item.label;
      const meta = document.createElement("span");
      meta.className = "palette-item-meta";
      meta.textContent = item.meta;
      btn.append(kind, name, meta);

      btn.addEventListener("click", () => go(item));
      list.appendChild(btn);
    });
  }

  function setActive(i: number) {
    const items = Array.from(list.querySelectorAll<HTMLElement>(".palette-item"));
    if (!items.length) return;
    active = (i + items.length) % items.length;
    items.forEach((el, idx) => (el.dataset.active = String(idx === active)));
    items[active].scrollIntoView({ block: "nearest" });
  }

  // `action:` hrefs are intents, not destinations: the options module in
  // src/scripts/options.ts listens for them, so the palette never needs to
  // know how the theme actually gets applied.
  function runAction(href: string) {
    const [, kind, value] = href.split(":");
    if (kind === "theme") {
      if (value === "toggle") document.dispatchEvent(new CustomEvent("opt:cycle-theme"));
      else document.dispatchEvent(new CustomEvent("opt:theme", { detail: value }));
    } else if (kind === "accent") {
      document.dispatchEvent(new CustomEvent("opt:accent", { detail: value }));
    } else if (kind === "lang") {
      document.dispatchEvent(new CustomEvent("opt:lang", { detail: value }));
    } else if (kind === "help") {
      document.dispatchEvent(new CustomEvent("opt:help"));
    } else if (kind === "diag") {
      document.dispatchEvent(new CustomEvent("opt:diag"));
    } else if (kind === "xray") {
      document.dispatchEvent(new CustomEvent("opt:xray"));
    } else if (kind === "brief") {
      document.dispatchEvent(new CustomEvent("opt:brief"));
    } else if (kind === "fit") {
      document.dispatchEvent(new CustomEvent("opt:fit"));
    } else if (kind === "profile") {
      // The palette is a launcher for the machine layer too: copy the whole
      // canonical record without leaving the keyboard.
      fetch("/profile.json", { headers: { accept: "application/json" } })
        .then((response) => {
          if (!response.ok) throw new Error(String(response.status));
          return response.text();
        })
        .then((text) => navigator.clipboard.writeText(text))
        .then(() => {
          document.dispatchEvent(
            new CustomEvent("ui:toast", {
              detail: backdrop.dataset.toastProfile ?? "Profile copied",
            })
          );
        })
        .catch(() => {});
    } else if (kind === "share") {
      // Reproduce the current view: palette preference + the section in view.
      const url = new URL(location.href);
      url.searchParams.set("theme", localStorage.getItem("cv:theme") ?? "system");
      url.searchParams.set("accent", localStorage.getItem("cv:accent") ?? "lime");
      url.hash = location.hash;
      navigator.clipboard
        ?.writeText(url.toString())
        .then(() =>
          document.dispatchEvent(
            new CustomEvent("ui:toast", { detail: backdrop.dataset.toastCopied ?? "Link copied" })
          )
        )
        .catch(() => {});
    }
  }

  function go(item: Item) {
    close();
    if (item.target) {
      reveal(item.target, item.tokens ?? []);
    } else if (item.href.startsWith("action:")) {
      runAction(item.href);
    } else if (item.href.startsWith("#")) {
      document.querySelector(item.href)?.scrollIntoView({ behavior: "smooth" });
    } else {
      window.open(item.href, "_blank", "noopener");
    }
  }

  function open() {
    backdrop.classList.add("open");
    document.body.style.overflow = "hidden";
    input.value = "";
    render("");
    requestAnimationFrame(() => input.focus());
  }

  function close() {
    backdrop.classList.remove("open");
    document.body.style.overflow = "";
  }

  document.addEventListener("keydown", (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
      e.preventDefault();
      backdrop.classList.contains("open") ? close() : open();
      return;
    }
    if (e.key === "/" && !backdrop.classList.contains("open")) {
      const tag = (document.activeElement as HTMLElement)?.tagName;
      if (tag !== "INPUT" && tag !== "TEXTAREA") {
        e.preventDefault();
        open();
      }
      return;
    }
    if (!backdrop.classList.contains("open")) return;
    if (e.key === "Escape") close();
    if (e.key === "ArrowDown") {
      e.preventDefault();
      setActive(active + 1);
    }
    if (e.key === "ArrowUp") {
      e.preventDefault();
      setActive(active - 1);
    }
    if (e.key === "Enter") {
      e.preventDefault();
      if (visible[active]) go(visible[active]);
    }
  });

  input.addEventListener("input", () => render(input.value));
  backdrop.addEventListener("click", (e) => {
    if (e.target === backdrop) close();
  });
  document.addEventListener("palette:open", () => open());
</script>

<style>
  .palette-item-kind {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-fog);
    border: 1px solid var(--color-line-2);
    padding: 0.15rem 0.5rem;
    flex: none;
    min-width: 4.5rem;
    text-align: center;
  }

  .palette-item-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
    flex: none;
    min-width: 12rem;
    transition: color 0.15s ease;
  }

  .palette-item-meta {
    color: var(--color-fog);
    font-size: 0.8125rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Full-text results are prose, not a title: the row becomes a snippet. */
  .palette-item[data-snippet="true"] {
    align-items: flex-start;
  }

  .palette-item[data-snippet="true"] .palette-item-name {
    flex: 1;
    min-width: 0;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-fog-2);
