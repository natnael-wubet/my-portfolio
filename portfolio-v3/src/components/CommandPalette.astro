---
import { deployments } from "../data/deployments";
import { repos, socials, awards, certifications, disciplines } from "../data/content";
import { locales, td, type Lang, type T } from "../i18n";

interface Props {
  t: T;
  lang: Lang;
}
const { t, lang } = Astro.props;

interface PaletteItem {
  label: string;
  meta: string;
  href: string;
  kind: string;
  keywords: string;
}

// Kinds are translated at build time — the payload is JSON, so the client
// only ever renders strings that already match the page's language.
const KIND = {
  deploy: t("palette.kind.Deploy"),
  repo: t("palette.kind.Repo"),
  award: t("palette.kind.Award"),
  cert: t("palette.kind.Cert"),
  link: t("palette.kind.Link"),
  doc: t("palette.kind.Doc"),
  play: t("palette.kind.Play"),
  mind: t("palette.kind.Mind"),
  jump: t("palette.kind.Jump"),
  option: t("palette.kind.Option"),
};

const items: PaletteItem[] = [
  ...deployments.map((d) => ({
    label: d.name,
    meta: `${d.platform} · ${td(t, d.tagline)}`,
    href: d.url,
    kind: KIND.deploy,
    keywords: `${d.name} ${d.tagline} ${td(t, d.tagline)} ${d.description} ${td(t, d.description)} ${d.stack.join(" ")} ${d.category}`,
  })),
  ...repos.map((r) => ({
    label: r.name,
    meta: `${t(`sec.repos.group.${r.group}`)} · ${td(t, r.description)}`,
    href: r.url,
    kind: KIND.repo,
    keywords: `${r.name} ${r.description} ${td(t, r.description)} ${r.language} ${r.group}`,
  })),
  ...awards.map((a) => ({
    label: a.title,
    meta: `${td(t, a.rank)} · ${a.org}`,
    href: "#awards",
    kind: KIND.award,
    keywords: `${a.title} ${a.org} ${a.detail} ${td(t, a.detail)} ${a.prize ?? ""} ${td(t, a.prize ?? "")} ${a.rank}`,
  })),
  ...certifications.map((c) => ({
    label: c.name,
    meta: c.issuer,
    href: c.file,
    kind: KIND.cert,
    keywords: `${c.name} ${c.issuer} ${c.detail}`,
  })),
  ...socials.map((s) => ({
    label: td(t, s.label),
    meta: s.handle,
    href: s.href,
    kind: KIND.link,
    keywords: `${s.label} ${td(t, s.label)} ${s.handle}`,
  })),
  { label: t("palette.cv"), meta: t("palette.cvMeta"), href: "/assets/cv.pdf", kind: KIND.doc, keywords: "cv resume curriculum vitae pdf download ሲቪ" },
  { label: t("palette.github"), meta: "@natnael-wubet", href: "https://github.com/natnael-wubet", kind: KIND.link, keywords: "github profile all repositories" },
  { label: t("palette.telegram"), meta: "@nnaty_w20", href: "https://t.me/nnaty_w20", kind: KIND.link, keywords: "telegram contact chat ቴሌግራም" },
  { label: t("palette.bigxo"), meta: t("palette.bigxoMeta"), href: "https://t.me/bigxoGameBot", kind: KIND.play, keywords: "bigxo game telegram mini app play xo" },
  // The interior — so "physics" or "hegel" lands somewhere real.
  ...disciplines.map((d) => ({
    label: td(t, d.name),
    meta: `${t("palette.interior")} · ${d.tags.slice(0, 3).map((tag) => td(t, tag)).join(" · ")}`,
    href: "#mind",
    kind: KIND.mind,
    keywords: `${d.name} ${td(t, d.name)} ${d.blurb} ${td(t, d.blurb)} ${d.tags.join(" ")} ${d.tags.map((tag) => td(t, tag)).join(" ")}`,
  })),
  // ── Display options — real actions, dispatched as events ──
  { label: t("palette.opt.toggleTheme"), meta: t("palette.opt.toggleThemeMeta"), href: "action:theme:toggle", kind: KIND.option, keywords: "theme dark light mode appearance toggle contrast" },
  { label: t("palette.opt.darkTheme"), meta: t("palette.opt.darkThemeMeta"), href: "action:theme:dark", kind: KIND.option, keywords: "theme dark night mode appearance" },
  { label: t("palette.opt.lightTheme"), meta: t("palette.opt.lightThemeMeta"), href: "action:theme:light", kind: KIND.option, keywords: "theme light day mode appearance" },
  { label: t("palette.opt.systemTheme"), meta: t("palette.opt.systemThemeMeta"), href: "action:theme:system", kind: KIND.option, keywords: "theme system auto os appearance" },
  ...(["lime", "cyan", "amber", "rose", "violet"] as const).map((a) => ({
    label: t("palette.opt.accent", { name: a }),
    meta: t("palette.opt.accentMeta"),
    href: `action:accent:${a}`,
    kind: KIND.option,
    keywords: `accent colour ${a} signal`,
  })),
  { label: t("palette.opt.shortcuts"), meta: t("palette.opt.shortcutsMeta"), href: "action:help", kind: KIND.option, keywords: "keyboard shortcuts help keys commands" },
  { label: t("palette.opt.share"), meta: t("palette.opt.shareMeta"), href: "action:share", kind: KIND.option, keywords: "share link url copy view theme accent section" },
  // Language is a navigation, not a state toggle: both locales are static.
  {
    label: lang === "en" ? t("palette.opt.langAm") : t("palette.opt.langEn"),
    meta: lang === "en" ? t("palette.opt.langAmMeta") : t("palette.opt.langEnMeta"),
    href: `action:lang:${locales[lang].alternate}`,
    kind: KIND.option,
    keywords: "language amharic english አማርኛ switch locale ቋንቋ",
  },
  // Section jumps.
  { label: t("palette.jump.work"), meta: t("palette.jump.workMeta"), href: "#work", kind: KIND.jump, keywords: "deployments projects live work shipped urls" },
  { label: t("palette.jump.origin"), meta: t("palette.jump.originMeta"), href: "#origin", kind: KIND.jump, keywords: "origin story history timeline 2014 bahir dar heritage" },
  { label: t("palette.jump.vault"), meta: t("palette.jump.vaultMeta"), href: "#vault", kind: KIND.jump, keywords: "cv vault resume three dimensional carousel" },
  { label: t("palette.jump.awards"), meta: t("palette.jump.awardsMeta"), href: "#awards", kind: KIND.jump, keywords: "awards record competitions certifications ccna" },
  { label: t("palette.jump.photos"), meta: t("palette.jump.photosMeta"), href: "#photos", kind: KIND.jump, keywords: "photos personal pictures selfies off-screen" },
  { label: t("palette.jump.contact"), meta: t("palette.jump.contactMeta"), href: "#connect", kind: KIND.jump, keywords: "contact email phone telegram hire reach" },
];
---

<div class="palette-backdrop" id="palette" role="dialog" aria-modal="true" aria-label={t("palette.aria")} data-toast-copied={t("ui.linkCopied")}>
  <div class="palette">
    <input
      class="palette-input"
      id="palette-input"
      type="text"
      placeholder={t("palette.placeholder")}
      autocomplete="off"
      spellcheck="false"
      aria-controls="palette-list"
    />
    <div class="palette-list" id="palette-list" role="listbox" data-empty={t("palette.empty")}></div>
  </div>
</div>

<!-- Payload rides as JSON so the script below can stay a real module. -->
<script type="application/json" id="palette-data" set:html={JSON.stringify(items)} />

<script>
  type Item = {
    label: string;
    meta: string;
    href: string;
    kind: string;
    keywords: string;
  };

  const payload = document.getElementById("palette-data")?.textContent ?? "[]";
  const data = JSON.parse(payload) as Item[];
  const backdrop = document.getElementById("palette") as HTMLDivElement;
  const input = document.getElementById("palette-input") as HTMLInputElement;
  const list = document.getElementById("palette-list") as HTMLDivElement;

  let active = 0;
  let visible: Item[] = [];

  // Tight fuzzy match: consecutive matched characters may not be more than a
  // few apart. This runs against the label only — the keyword blob contains
  // whole project descriptions, where a loose subsequence matches anything
  // (searching "physics" used to return unrelated deployments).
  function fuzzy(hay: string, needle: string, maxGap = 4): boolean {
    if (needle.length < 3) return false;
    for (let start = 0; start < hay.length; start++) {
      if (hay[start] !== needle[0]) continue;
      let i = 1;
      let prev = start;
      for (let j = start + 1; j < hay.length && i < needle.length; j++) {
        if (hay[j] !== needle[i]) continue;
        if (j - prev - 1 > maxGap) break;
        prev = j;
        i++;
      }
      if (i === needle.length) return true;
    }
    return false;
  }

  function score(item: Item, q: string): number {
    const hay = item.keywords.toLowerCase();
    const label = item.label.toLowerCase();
    if (label === q) return 100;
    if (label.startsWith(q)) return 80;
    if (label.includes(q)) return 60;
    if (hay.includes(q)) return 30;
    // Multi-word query: every word has to appear somewhere in the blob.
    const words = q.split(/\s+/).filter(Boolean);
    if (words.length > 1 && words.every((w) => hay.includes(w))) return 25;
    if (fuzzy(label, q)) return 12;
    return 0;
  }

  function render(query: string) {
    const q = query.trim().toLowerCase();
    visible = q
      ? data
          .map((item) => ({ item, s: score(item, q) }))
          .filter((x) => x.s > 0)
          .sort((a, b) => b.s - a.s)
          .slice(0, 40)
          .map((x) => x.item)
      : data.slice(0, 24);

    active = 0;
    list.innerHTML = "";

    if (visible.length === 0) {
      list.innerHTML = "";
      const note = document.createElement("div");
      note.className = "palette-empty";
      note.textContent = list.dataset.empty ?? "";
      list.appendChild(note);
      return;
    }

    visible.forEach((item, i) => {
      const btn = document.createElement("button");
      btn.className = "palette-item";
      btn.type = "button";
      btn.dataset.active = String(i === 0);
      btn.setAttribute("role", "option");

      const kind = document.createElement("span");
      kind.className = "palette-item-kind";
      kind.textContent = item.kind;
      const name = document.createElement("span");
      name.className = "palette-item-name";
      name.textContent = item.label;
      const meta = document.createElement("span");
      meta.className = "palette-item-meta";
      meta.textContent = item.meta;
      btn.append(kind, name, meta);

      btn.addEventListener("click", () => go(item));
      list.appendChild(btn);
    });
  }

  function setActive(i: number) {
    const items = Array.from(list.querySelectorAll<HTMLElement>(".palette-item"));
    if (!items.length) return;
    active = (i + items.length) % items.length;
    items.forEach((el, idx) => (el.dataset.active = String(idx === active)));
    items[active].scrollIntoView({ block: "nearest" });
  }

  // `action:` hrefs are intents, not destinations: the options module in
  // src/scripts/options.ts listens for them, so the palette never needs to
  // know how the theme actually gets applied.
  function runAction(href: string) {
    const [, kind, value] = href.split(":");
    if (kind === "theme") {
      if (value === "toggle") document.dispatchEvent(new CustomEvent("opt:cycle-theme"));
      else document.dispatchEvent(new CustomEvent("opt:theme", { detail: value }));
    } else if (kind === "accent") {
      document.dispatchEvent(new CustomEvent("opt:accent", { detail: value }));
    } else if (kind === "lang") {
      document.dispatchEvent(new CustomEvent("opt:lang", { detail: value }));
    } else if (kind === "help") {
      document.dispatchEvent(new CustomEvent("opt:help"));
    } else if (kind === "share") {
      // Reproduce the current view: palette preference + the section in view.
      const url = new URL(location.href);
      url.searchParams.set("theme", localStorage.getItem("cv:theme") ?? "system");
      url.searchParams.set("accent", localStorage.getItem("cv:accent") ?? "lime");
      url.hash = location.hash;
      navigator.clipboard
        ?.writeText(url.toString())
        .then(() =>
          document.dispatchEvent(
            new CustomEvent("ui:toast", { detail: backdrop.dataset.toastCopied ?? "Link copied" })
          )
        )
        .catch(() => {});
    }
  }

  function go(item: Item) {
    close();
    if (item.href.startsWith("action:")) {
      runAction(item.href);
    } else if (item.href.startsWith("#")) {
      document.querySelector(item.href)?.scrollIntoView({ behavior: "smooth" });
    } else {
      window.open(item.href, "_blank", "noopener");
    }
  }

  function open() {
    backdrop.classList.add("open");
    document.body.style.overflow = "hidden";
    input.value = "";
    render("");
    requestAnimationFrame(() => input.focus());
  }

  function close() {
    backdrop.classList.remove("open");
    document.body.style.overflow = "";
  }

  document.addEventListener("keydown", (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
      e.preventDefault();
      backdrop.classList.contains("open") ? close() : open();
      return;
    }
    if (e.key === "/" && !backdrop.classList.contains("open")) {
      const tag = (document.activeElement as HTMLElement)?.tagName;
      if (tag !== "INPUT" && tag !== "TEXTAREA") {
        e.preventDefault();
        open();
      }
      return;
    }
    if (!backdrop.classList.contains("open")) return;
    if (e.key === "Escape") close();
    if (e.key === "ArrowDown") {
      e.preventDefault();
      setActive(active + 1);
    }
    if (e.key === "ArrowUp") {
      e.preventDefault();
      setActive(active - 1);
    }
    if (e.key === "Enter") {
      e.preventDefault();
      if (visible[active]) go(visible[active]);
    }
  });

  input.addEventListener("input", () => render(input.value));
  backdrop.addEventListener("click", (e) => {
    if (e.target === backdrop) close();
  });
  document.addEventListener("palette:open", () => open());
</script>

<style>
  .palette-item-kind {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-fog);
    border: 1px solid var(--color-line-2);
    padding: 0.15rem 0.5rem;
    flex: none;
    min-width: 4.5rem;
    text-align: center;
  }

  .palette-item-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
    flex: none;
    min-width: 12rem;
    transition: color 0.15s ease;
  }

  .palette-item-meta {
    color: var(--color-fog);
    font-size: 0.8125rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .palette-item {
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .palette-item-name {
      min-width: 0;
    }
    .palette-item-meta {
      width: 100%;
    }
  }
</style>
