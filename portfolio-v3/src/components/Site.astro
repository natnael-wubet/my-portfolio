---
/**
 * The whole single-page site, parameterised by language. Both routes render
 * this component: "/" passes "en", "/am/" passes "am".
 *
 * The page reads as an argument, in order: who I am, the one project that
 * deserves a full block, three featured projects, the repository assessments,
 * then the record and the long tail.
 */
import Base from "../layouts/Base.astro";
import Nav from "./Nav.astro";
import Hero from "./Hero.astro";
import Signature from "./Signature.astro";
import HeroProject from "./HeroProject.astro";
import FeaturedWork from "./FeaturedWork.astro";
import ReadClosely from "./ReadClosely.astro";
import Repos from "./Repos.astro";
import Origin from "./Origin.astro";
import Vault from "./Vault.astro";
import Mind from "./Mind.astro";
import Awards from "./Awards.astro";
import Photos from "./Photos.astro";
import LiveDeployments from "./LiveDeployments.astro";
import Connect from "./Connect.astro";
import Footer from "./Footer.astro";
import CommandPalette from "./CommandPalette.astro";
import Shortcuts from "./Shortcuts.astro";
import Instrument from "./Instrument.astro";
import Brief from "./Brief.astro";
import Fit from "./Fit.astro";
import ProjectDialog from "./ProjectDialog.astro";
import ArchiveDialog from "./ArchiveDialog.astro";
import { makeT, type Lang } from "../i18n";
import { repos } from "../data/content";
import { deployments } from "../data/deployments";
import { getWorkRows, toProjectRecords } from "../lib/work";
import { validateDeployments } from "../lib/content-checks";
import { buildInfo } from "../lib/build";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = makeT(lang);
const build = buildInfo();

// Fail the build on a hero/featured entry that is missing its card copy.
validateDeployments();

const rows = await getWorkRows(t);
const hero = rows.find((row) => row.tier === "hero");
if (!hero) throw new Error("No tier: \"hero\" deployment is defined.");

const featured = rows.filter((row) => row.tier === "featured");
const longTail = rows.filter((row) => (row.tier ?? "standard") === "standard" && !row.archived);
const probed = rows.filter((row) => !row.archived);
const live = probed.filter((row) => row.health.status === "live").length;

const description = t("meta.descriptionCounted", { live, repos: repos.length });
---

<Base lang={lang} description={description}>
  <Nav t={t} lang={lang} />
  <main id="main" tabindex="-1" class="relative z-10">
    <Hero t={t} />
    <Signature t={t} />
    <HeroProject t={t} projects={[...featured, hero]} />
    <FeaturedWork t={t} projects={featured} count={rows.length} />
    <ReadClosely t={t} />
    <Origin t={t} />
    <Mind t={t} />
    <Vault t={t} />
    <Awards t={t} />
    <Photos t={t} />
    <LiveDeployments t={t} projects={longTail} live={live} probed={probed.length} count={rows.length} />
    <Repos t={t} />
    <Connect t={t} />
  </main>
  <Footer t={t} />
  <CommandPalette t={t} lang={lang} />
  <Shortcuts t={t} />
  <Instrument t={t} build={build} />
  <Brief t={t} lang={lang} build={build} />
  <Fit t={t} lang={lang} />
  <ArchiveDialog t={t} rows={rows} />
  <ProjectDialog t={t} projects={toProjectRecords(rows, lang)} />
</Base>