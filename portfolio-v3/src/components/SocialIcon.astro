---
/**
 * Compact line icons for the contact list.
 *
 * They are drawn in one 24×24 box with currentColor strokes so the rows can
 * tint them on hover. These are deliberately simple marks, not brand assets.
 */
interface Props {
  name: string;
}
const { name } = Astro.props;
---

<svg
  class="social-icon"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === "github" && (
      <>
        <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
      </>
    )
  }
  {
    name === "linkedin" && (
      <>
        <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z" />
        <rect x="2" y="9" width="4" height="12" />
        <circle cx="4" cy="4" r="2" />
      </>
    )
  }
  {
    name === "telegram" && (
      <>
        <path d="M21.4 2.6 2.9 9.5c-.9.3-.9 1.5 0 1.8l4.7 1.5 1.8 5.3c.3.8 1.2 1 1.8.4l2.5-2.3 4.6 3.4c.7.5 1.6.1 1.8-.7l3.3-14.8c.2-.9-.7-1.7-1.6-1.4z" />
        <path d="m7.6 12.8 9.7-6.5-7.3 7.3" />
      </>
    )
  }
  {
    name === "instagram" && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    name === "youtube" && (
      <>
        <rect x="2.5" y="5.5" width="19" height="13" rx="4" />
        <path d="m10.5 9.5 5 2.5-5 2.5z" />
      </>
    )
  }
  {
    name === "tiktok" && (
      <>
        <path d="M15 3v9.5a3.5 3.5 0 1 1-3-3.46" />
        <path d="M15 3c.4 2.4 2 4 4.5 4.3" />
      </>
    )
  }
  {
    name === "reddit" && (
      <>
        <circle cx="12" cy="14" r="6.5" />
        <path d="M12 7.5V4m0 0 3.5-1.5M9 12.5h.01M15 12.5h.01M9.5 16.5c1.5 1 3.5 1 5 0" />
        <circle cx="18.5" cy="5.5" r="1.4" />
      </>
    )
  }
  {
    name === "mail" && (
      <>
        <rect x="2.5" y="5" width="19" height="14" rx="2" />
        <path d="m3.5 6.5 8.5 6 8.5-6" />
      </>
    )
  }
  {
    name === "phone" && (
      <path d="M5.5 3.5h3l1.5 4-2 1.5a12 12 0 0 0 5.5 5.5l1.5-2 4 1.5v3a2 2 0 0 1-2.2 2A17 17 0 0 1 3.5 5.7a2 2 0 0 1 2-2.2z" />
    )
  }
  {
    !["github", "linkedin", "telegram", "instagram", "youtube", "tiktok", "reddit", "mail", "phone"].includes(name) && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M8.5 12h7M12 8.5v7" />
      </>
    )
  }
</svg>

<style>
  .social-icon {
    width: 100%;
    height: 100%;
    color: inherit;
  }
</style>
