---
import DisplayOptions from "./DisplayOptions.astro";
import { locales, type Lang, type T } from "../i18n";

interface Props {
  t: T;
  lang: Lang;
}
const { t, lang } = Astro.props;

const target = locales[locales[lang].alternate];
const switchLabel = lang === "en" ? t("lang.am") : t("lang.en");

const links = [
  { href: "#work", label: t("nav.work") },
  { href: "#origin", label: t("nav.origin") },
  { href: "#mind", label: t("nav.mind") },
  { href: "#vault", label: t("nav.vault") },
  { href: "#awards", label: t("nav.awards") },
  { href: "#connect", label: t("nav.contact") },
];
---

<header
  id="nav"
  data-lang={lang}
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-[background-color,border-color,backdrop-filter] duration-300"
>
  <div class="shell flex h-16 items-center justify-between gap-6">
    <a href="#top" class="group flex items-center gap-3 no-underline">
      <img
        src="/logo.jpg"
        alt="Natnael Wubet"
        width="96"
        height="96"
        class="h-9 w-9 flex-none border border-[var(--color-line-2)] object-cover transition-all duration-500 group-hover:border-[var(--color-signal)] group-hover:shadow-[0_0_18px_-4px_var(--color-signal)]"
      />
      <span class="flex flex-col leading-none">
        <span class="font-display text-sm font-semibold tracking-tight">Natnael Wubet</span>
        <span class="font-mono text-[0.625rem] tracking-[0.18em] text-[var(--color-fog)] uppercase">{t("nav.role")}</span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:flex">
      {
        links.map((l, i) => (
          <a
            href={l.href}
            data-nav={l.href.slice(1)}
            class="nav-link group relative px-3 py-2 font-mono text-[0.6875rem] tracking-[0.18em] text-[var(--color-fog)] uppercase no-underline transition-colors hover:text-[var(--color-chalk)]"
          >
            <span class="nav-num text-[var(--color-line-2)] transition-colors group-hover:text-[var(--color-signal)]">{String(i + 1).padStart(2, "0")}</span>
            <span class="ml-2">{l.label}</span>
            <span class="nav-underline" aria-hidden="true"></span>
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <button
        id="palette-trigger"
        type="button"
        class="hidden items-center gap-3 border border-[var(--color-line)] px-3 py-2 font-mono text-[0.6875rem] tracking-[0.12em] text-[var(--color-fog)] uppercase transition-colors hover:border-[var(--color-line-2)] hover:text-[var(--color-chalk)] sm:flex"
      >
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        {t("nav.search")}
        <kbd class="border border-[var(--color-line-2)] px-1.5 py-0.5 text-[0.5625rem] text-[var(--color-fog-2)]">⌘K</kbd>
      </button>

      <DisplayOptions t={t} />

      <a
        href={target.href}
        hreflang={target.htmlLang}
        data-lang-switch
        class="grid h-9 min-w-9 place-items-center border border-[var(--color-line)] px-2.5 font-mono text-[0.6875rem] tracking-[0.1em] text-[var(--color-fog)] no-underline transition-colors hover:border-[var(--color-line-2)] hover:text-[var(--color-chalk)]"
        aria-label={t("nav.langSwitch")}
        title={target.native}
      >
        {switchLabel}
      </a>

      <a class="btn btn-primary btn-sm" href="/assets/cv.pdf" download>{t("nav.cv")}</a>

      <button
        id="nav-toggle"
        type="button"
        class="grid h-9 w-9 place-items-center border border-[var(--color-line)] md:hidden"
        aria-label={t("nav.menu")}
      >
        <span class="flex flex-col gap-[3px]">
          <span class="block h-px w-4 bg-[var(--color-chalk)]"></span>
          <span class="block h-px w-4 bg-[var(--color-chalk)]"></span>
        </span>
      </button>
    </div>
  </div>

  <div id="nav-menu" class="hidden border-t border-[var(--color-line)] bg-[var(--color-ink-2)] md:hidden">
    <div class="shell flex flex-col py-2">
      {
        links.map((l, i) => (
          <a
            href={l.href}
            class="flex items-center gap-4 border-b border-[var(--color-line)] py-3.5 font-mono text-[0.75rem] tracking-[0.18em] text-[var(--color-fog-2)] uppercase no-underline last:border-0"
          >
            <span class="text-[var(--color-line-2)]">{String(i + 1).padStart(2, "0")}</span>
            {l.label}
          </a>
        ))
      }
    </div>
  </div>
</header>

<script>
  const nav = document.getElementById("nav") as HTMLElement;
  const trigger = document.getElementById("palette-trigger") as HTMLButtonElement;
  const toggle = document.getElementById("nav-toggle") as HTMLButtonElement;
  const menu = document.getElementById("nav-menu") as HTMLElement;
  const header = document.getElementById("nav") as HTMLElement;
  const langSwitch = document.querySelector<HTMLAnchorElement>("a[data-lang-switch]");

  // ── Language switching ────────────────────────────────────
  // Both locales are static pages, so switching is a navigation — but the
  // current section should survive it, hence the hash carry.
  const goToLocale = (href: string) => {
    location.href = href + location.hash;
  };
  langSwitch?.addEventListener("click", (e) => {
    e.preventDefault();
    const href = langSwitch.getAttribute("href");
    if (href) goToLocale(href);
  });
  document.addEventListener("opt:lang", (e) => {
    const want = (e as CustomEvent<string>).detail;
    const current = header.dataset.lang;
    if (want === current) return;
    goToLocale(want === "am" ? "/am/" : "/");
  });

  const onScroll = () => {
    // Class, not inline styles: the colours come from the theme tokens so
    // the bar stays correct in light mode too.
    nav.classList.toggle("is-scrolled", window.scrollY > 24);
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  trigger?.addEventListener("click", () => document.dispatchEvent(new CustomEvent("palette:open")));

  toggle?.addEventListener("click", () => menu.classList.toggle("hidden"));

  menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => menu.classList.add("hidden")));

  // ── Active section indicator ────────────────────────────────
  // Track whichever section owns the band just under the header, so the nav
  // reads as an instrument dial rather than a static list.
  const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("#nav a[data-nav]"));
  if (navLinks.length && "IntersectionObserver" in window) {
    const sections = navLinks
      .map((a) => document.getElementById(a.dataset.nav ?? ""))
      .filter((s): s is HTMLElement => !!s);

    const setActive = (id: string) => {
      navLinks.forEach((a) => {
        const on = a.dataset.nav === id;
        a.classList.toggle("is-active", on);
        if (on) a.setAttribute("aria-current", "true");
        else a.removeAttribute("aria-current");
      });
    };

    // A thin band across the top of the viewport decides the active section —
    // stable against long sections and short ones alike.
    const io = new IntersectionObserver(
      (entries) => {
        const hit = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        if (hit) setActive(hit.target.id);
      },
      { rootMargin: "-15% 0px -70% 0px", threshold: 0 }
    );
    sections.forEach((s) => io.observe(s));
  }
</script>

<style>
  #nav.is-scrolled {
    background-color: color-mix(in srgb, var(--color-ink) 86%, transparent);
    backdrop-filter: blur(14px);
    border-bottom-color: var(--color-line);
  }

  .nav-underline {
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.15rem;
    height: 1px;
    background: var(--color-signal);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-link.is-active {
    color: var(--color-chalk);
  }

  .nav-link.is-active .nav-num {
    color: var(--color-signal);
  }

  .nav-link.is-active .nav-underline {
    transform: scaleX(1);
  }

  .nav-link:hover .nav-underline {
    transform: scaleX(1);
    background: var(--color-line-2);
  }
</style>
