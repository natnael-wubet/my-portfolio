---
const links = [
  { href: "#work", label: "Work" },
  { href: "#vault", label: "CV" },
  { href: "#repos", label: "Repos" },
  { href: "#awards", label: "Awards" },
  { href: "#connect", label: "Contact" },
];
---

<header
  id="nav"
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-[background-color,border-color,backdrop-filter] duration-300"
>
  <div class="shell flex h-16 items-center justify-between gap-6">
    <a href="#top" class="group flex items-center gap-3 no-underline">
      <span
        class="grid h-8 w-8 place-items-center border border-[--color-line-2] font-mono text-[0.6875rem] font-medium text-[--color-signal] transition-colors group-hover:border-[--color-signal]"
        >NW</span
      >
      <span class="flex flex-col leading-none">
        <span class="font-display text-sm font-semibold tracking-tight">Natnael Wubet</span>
        <span class="font-mono text-[0.625rem] tracking-[0.18em] text-[--color-fog] uppercase">Software Engineer</span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:flex">
      {
        links.map((l, i) => (
          <a
            href={l.href}
            class="group relative px-3 py-2 font-mono text-[0.6875rem] tracking-[0.18em] text-[--color-fog] uppercase no-underline transition-colors hover:text-[--color-chalk]"
          >
            <span class="text-[--color-line-2] group-hover:text-[--color-signal]">{String(i + 1).padStart(2, "0")}</span>
            <span class="ml-2">{l.label}</span>
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <button
        id="palette-trigger"
        type="button"
        class="hidden items-center gap-3 border border-[--color-line] px-3 py-2 font-mono text-[0.6875rem] tracking-[0.12em] text-[--color-fog] uppercase transition-colors hover:border-[--color-line-2] hover:text-[--color-chalk] sm:flex"
      >
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        Search
        <kbd class="border border-[--color-line-2] px-1.5 py-0.5 text-[0.5625rem] text-[--color-fog-2]">⌘K</kbd>
      </button>

      <a class="btn btn-primary btn-sm" href="/assets/cv.pdf" download>CV ↓</a>

      <button
        id="nav-toggle"
        type="button"
        class="grid h-9 w-9 place-items-center border border-[--color-line] md:hidden"
        aria-label="Menu"
      >
        <span class="flex flex-col gap-[3px]">
          <span class="block h-px w-4 bg-[--color-chalk]"></span>
          <span class="block h-px w-4 bg-[--color-chalk]"></span>
        </span>
      </button>
    </div>
  </div>

  <div id="nav-menu" class="hidden border-t border-[--color-line] bg-[--color-ink-2] md:hidden">
    <div class="shell flex flex-col py-2">
      {
        links.map((l, i) => (
          <a
            href={l.href}
            class="flex items-center gap-4 border-b border-[--color-line] py-3.5 font-mono text-[0.75rem] tracking-[0.18em] text-[--color-fog-2] uppercase no-underline last:border-0"
          >
            <span class="text-[--color-line-2]">{String(i + 1).padStart(2, "0")}</span>
            {l.label}
          </a>
        ))
      }
    </div>
  </div>
</header>

<script>
  const nav = document.getElementById("nav") as HTMLElement;
  const trigger = document.getElementById("palette-trigger") as HTMLButtonElement;
  const toggle = document.getElementById("nav-toggle") as HTMLButtonElement;
  const menu = document.getElementById("nav-menu") as HTMLElement;

  const onScroll = () => {
    const y = window.scrollY;
    if (y > 24) {
      nav.style.backgroundColor = "color-mix(in srgb, #08090a 86%, transparent)";
      nav.style.backdropFilter = "blur(14px)";
      nav.style.borderBottomColor = "#1e2226";
    } else {
      nav.style.backgroundColor = "transparent";
      nav.style.backdropFilter = "none";
      nav.style.borderBottomColor = "transparent";
    }
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  trigger?.addEventListener("click", () => document.dispatchEvent(new CustomEvent("palette:open")));

  toggle?.addEventListener("click", () => menu.classList.toggle("hidden"));

  menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => menu.classList.add("hidden")));
</script>
