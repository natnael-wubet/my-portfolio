---
import { socials, repos, awards } from "../data/content";
import { deployments } from "../data/deployments";
import { rich, td, type T } from "../i18n";
import Machine from "./Machine.astro";

interface Props {
  t: T;
}
const { t } = Astro.props;

const primary = socials.filter((s) => ["GitHub", "LinkedIn", "Telegram", "Email"].includes(s.label));
const rest = socials.filter((s) => !["GitHub", "LinkedIn", "Telegram", "Email"].includes(s.label));

const stats = {
  live: deployments.filter((d) => !d.archived).length,
  repos: repos.length,
  awards: awards.length,
};

// The terminal answers client-side, so its strings ride along as JSON.
const cmds = {
  hire: t("sec.connect.cmd.hire"),
  help: t("sec.connect.cmd.help"),
  work: t("sec.connect.cmd.work", stats),
  stack: t("sec.connect.cmd.stack"),
  github: t("sec.connect.cmd.github"),
  tg: t("sec.connect.cmd.tg"),
  hi: t("sec.connect.cmd.hi"),
  hello: t("sec.connect.cmd.hi"),
  unknown: t("sec.connect.cmd.unknown", { cmd: "{cmd}" }),
};
---

<section id="connect" class="relative border-t border-[var(--color-line)]">
  <div class="shell py-24 lg:py-32">
    <div class="grid gap-14 lg:grid-cols-[1.1fr_1fr] lg:gap-20">
      <div class="flex flex-col gap-8">
        <div class="flex flex-col gap-5" data-reveal>
          <span class="eyebrow">{t("sec.connect.eyebrow")}</span>
          <h2 class="display display-lg" set:html={rich(t("sec.connect.title"))} />
        </div>

        <div class="flex flex-col gap-3">
          {
            primary.map((s, i) => (
              <a
                href={s.href}
                target={s.href.startsWith("mailto:") || s.href.startsWith("tel:") ? undefined : "_blank"}
                rel="noopener"
                class="group flex items-center gap-5 border border-[var(--color-line)] p-5 no-underline transition-all hover:border-[var(--color-signal)] hover:bg-[var(--color-ink-2)]"
                data-reveal
                style={`--d:${80 + i * 70}ms`}
              >
                <span class="grid h-10 w-10 flex-none place-items-center border border-[var(--color-line-2)] font-mono text-[0.625rem] uppercase transition-colors group-hover:border-[var(--color-signal)] group-hover:text-[var(--color-signal)]">
                  {s.label.slice(0, 2)}
                </span>
                <span class="flex min-w-0 flex-col">
                  <span class="font-mono text-[0.625rem] tracking-[0.2em] text-[var(--color-fog)] uppercase">{td(t, s.label)}</span>
                  <span class="truncate font-display text-base font-semibold text-[var(--color-chalk)] transition-colors group-hover:text-[var(--color-signal)]">
                    {s.handle}
                  </span>
                </span>
                <span class="ml-auto font-mono text-[var(--color-line-2)] transition-all group-hover:translate-x-1 group-hover:text-[var(--color-signal)]">
                  ↗
                </span>
              </a>
            ))
          }
        </div>
      </div>

      <div class="flex flex-col gap-8">
        <!-- Terminal -->
        <div class="panel flex flex-col overflow-hidden">
          <div class="flex items-center gap-2 border-b border-[var(--color-line)] px-4 py-3">
            <span class="h-2 w-2 rounded-full bg-[var(--color-rose)]/70"></span>
            <span class="h-2 w-2 rounded-full bg-[var(--color-amber)]/70"></span>
            <span class="h-2 w-2 rounded-full bg-[var(--color-signal)]/70"></span>
            <span class="ml-3 font-mono text-[0.625rem] tracking-[0.16em] text-[var(--color-fog)] uppercase">{t("sec.connect.termTitle")}</span>
          </div>
          <div class="flex flex-col gap-3 p-5 font-mono text-[0.8125rem] leading-relaxed">
            <div class="term-line"><span class="term-prompt">➜</span><span class="text-[var(--color-fog-2)]">{t("sec.connect.whoami")}</span></div>
            <div class="text-[var(--color-chalk)]">{t("sec.connect.whoamiOut")}</div>
            <div class="term-line"><span class="term-prompt">➜</span><span class="text-[var(--color-fog-2)]">{t("sec.connect.location")}</span></div>
            <div class="text-[var(--color-chalk)]" set:html={rich(t("sec.connect.locationOut"))} />
            <div class="term-line"><span class="term-prompt">➜</span><span class="text-[var(--color-fog-2)]">{t("sec.connect.status")}</span></div>
            <div class="flex items-center gap-2">
              <span class="status" data-state="live"><span class="status-dot"></span>{t("sec.connect.open")}</span>
            </div>
            <div class="term-line mt-1">
              <span class="term-prompt">➜</span>
              <input class="term-input" id="term-input" type="text" placeholder={t("sec.connect.termPlaceholder")} autocomplete="off" spellcheck="false" />
            </div>
            <div
              id="term-out"
              class="min-h-[1.5rem] cursor-copy whitespace-pre-wrap text-[var(--color-signal)]"
              title={t("sec.connect.copyHint")}
              data-copied={t("sec.connect.copied")}
              data-stats={JSON.stringify(stats)}
              data-cmds={JSON.stringify(cmds)}
            ></div>
          </div>
        </div>

        <!-- other links -->
        <div class="flex flex-wrap gap-2">
          {
            rest.map((s) => (
              <a
                href={s.href}
                target={s.href.startsWith("mailto:") || s.href.startsWith("tel:") ? undefined : "_blank"}
                rel="noopener"
                class="group flex items-center gap-2.5 border border-[var(--color-line)] px-3.5 py-2.5 no-underline transition-colors hover:border-[var(--color-signal)]"
              >
                <span class="font-mono text-[0.625rem] tracking-[0.16em] text-[var(--color-fog)] uppercase transition-colors group-hover:text-[var(--color-chalk)]">
                  {td(t, s.label)}
                </span>
                <span class="font-mono text-[0.6875rem] text-[var(--color-fog-2)]">{s.handle}</span>
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <Machine t={t} />
  </div>
</section>

<script>
  const input = document.getElementById("term-input") as HTMLInputElement | null;
  const out = document.getElementById("term-out") as HTMLDivElement | null;

  // Counts and command strings ride on the output node as JSON so this stays
  // a real module, and the answers match the page's language.
  type Stats = { live: number; repos: number; awards: number };
  const stats: Stats = out?.dataset.stats ? JSON.parse(out.dataset.stats) : { live: 0, repos: 0, awards: 0 };
  const cmds: Record<string, string> = out?.dataset.cmds ? JSON.parse(out.dataset.cmds) : {};

  const respond = (raw: string) => {
    const cmd = raw.trim().toLowerCase();
    if (!cmd) return;
    if (cmd === "clear") {
      out!.textContent = "";
      return;
    }
    if (cmd === "copy" || cmd === "cp") {
      const text = out!.textContent?.trim();
      if (text) {
        navigator.clipboard?.writeText(text).catch(() => {});
        document.dispatchEvent(new CustomEvent("ui:toast", { detail: out!.dataset.copied ?? "Copied" }));
      }
      return;
    }
    if (cmd in cmds) {
      out!.textContent = cmds[cmd];
      return;
    }
    out!.textContent = (cmds.unknown ?? "command not found: {cmd} — try 'help'").replace("{cmd}", cmd);
  };

  input?.addEventListener("keydown", (e) => {
    if (e.key !== "Enter") return;
    respond(input.value);
    input.value = "";
  });

  // ── Copy an answer ───────────────────────────────────────
  //    The terminal is a text surface, so the natural gesture is: tap the
  //    answer, get it on the clipboard. The shared toast confirms it.
  out?.addEventListener("click", async () => {
    const text = out.textContent?.trim();
    if (!text) return;
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      // Clipboard is unavailable in some contexts; the toast still confirms
      // the gesture so the interface never feels broken.
    }
    document.dispatchEvent(new CustomEvent("ui:toast", { detail: out.dataset.copied ?? "Copied" }));
  });
</script>
