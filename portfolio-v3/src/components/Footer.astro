---
import { rich, type T } from "../i18n";

interface Props {
  t: T;
  home?: boolean;
  lang?: "en" | "am";
}
const { t, home = true, lang = "en" } = Astro.props;
const prefix = home ? "" : lang === "en" ? "/" : "/am/";

const year = new Date().getFullYear();

const sections: [string, string][] = [
  ["#work", t("footer.work")],
  ["#repos", t("footer.repos")],
  ["#origin", t("footer.origin")],
  ["#vault", t("footer.vault")],
  ["#mind", t("footer.mind")],
  ["#awards", t("footer.awards")],
  ["#photos", t("footer.photos")],
  ["#connect", t("footer.contact")],
];
---

<footer class="relative border-t border-[var(--color-line)] bg-[var(--color-ink-2)]">
  <div class="shell py-16">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
      <div class="flex flex-col gap-4">
        <span class="flex items-center gap-3">
          <img src="/logo.jpg" alt="Natnael Wubet" width="96" height="96" class="h-9 w-9 flex-none border border-[var(--color-line-2)] object-cover" />
          <span class="font-display text-base font-semibold tracking-tight">Natnael Wubet</span>
        </span>
        <p class="max-w-sm text-sm leading-relaxed text-[var(--color-fog-2)]">
          {t("footer.blurb")}
        </p>
        <span class="status" data-state="live"><span class="status-dot"></span>{t("footer.operational")}</span>
        <p class="flex max-w-sm flex-wrap items-baseline gap-x-2 gap-y-1 text-sm leading-relaxed text-[var(--color-fog-2)]">
          <span class="font-mono text-[0.625rem] tracking-[0.18em] text-[var(--color-signal)] uppercase">{t("footer.nowLabel")}</span>
          <span>{t("footer.now")}</span>
        </p>
      </div>

      <nav class="flex flex-col gap-2.5">
        <span class="section-label mb-1">{t("footer.sections")}</span>
        {
          sections.map(([href, label]) => (
            <a href={`${prefix}${href}`} class="font-mono text-[0.75rem] tracking-[0.1em] text-[var(--color-fog-2)] uppercase no-underline transition-colors hover:text-[var(--color-signal)]">
              {label}
            </a>
          ))
        }
      </nav>

      <div class="flex flex-col gap-2.5">
        <span class="section-label mb-1">{t("footer.direct")}</span>
        <a href="mailto:natyw4122@gmail.com" class="font-mono text-[0.75rem] text-[var(--color-fog-2)] no-underline transition-colors hover:text-[var(--color-signal)]">natyw4122@gmail.com</a>
        <a href="tel:+251918191930" class="font-mono text-[0.75rem] text-[var(--color-fog-2)] no-underline transition-colors hover:text-[var(--color-signal)]">+251 91 819 1930</a>
        <a href="https://t.me/nnaty_w20" target="_blank" rel="noopener" class="font-mono text-[0.75rem] text-[var(--color-fog-2)] no-underline transition-colors hover:text-[var(--color-signal)]">@nnaty_w20</a>
        <a href="/assets/cv.pdf" download class="mt-2 btn btn-sm w-fit">CV ↓</a>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t border-[var(--color-line)] pt-6 sm:flex-row sm:items-center sm:justify-between">
      <span class="font-mono text-[0.625rem] tracking-[0.18em] text-[var(--color-fog)] uppercase">
        {t("footer.built", { year })}
      </span>
      <span class="font-mono text-[0.625rem] tracking-[0.18em] text-[var(--color-fog)] uppercase" set:html={rich(t("footer.probed"))} />
    </div>
  </div>
</footer>
